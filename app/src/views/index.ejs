<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SwapMart - Trade, Swap &amp; Save | Switzerland's Fairest Marketplace</title>
  <meta name="description" content="SwapMart is Switzerland's fairest marketplace. From 4% commission on high-value items. Tiered pricing that rewards bigger sales. Barter system, Swap + Cash deals, and 3 free listings per month.">
  <meta name="keywords" content="Swiss marketplace, buy sell Switzerland, barter trade, swap items, Pokemon cards, used cars, apartments, CHF, low fees marketplace">
  <meta name="author" content="SwapMart AG">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="SwapMart - Trade, Swap &amp; Save | Switzerland's Fairest Marketplace">
  <meta property="og:description" content="From 4% commission on high-value items. Tiered pricing that rewards bigger sales. Unique barter/swap system. 3 free listings/month. Swiss-focused with CHF, Swiss Post and local pickup.">
  <meta property="og:site_name" content="SwapMart">
  <meta property="og:locale" content="en_CH">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="SwapMart - Switzerland's Fairest Marketplace">
  <meta name="twitter:description" content="From 4% commission on high-value items. Tiered pricing that rewards bigger sales. Unique barter/swap system. 3 free listings/month.">

  <meta name="theme-color" content="#0d9488">

  <!-- JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SwapMart",
    "description": "Switzerland's fairest marketplace for trading, swapping and selling items.",
    "foundingDate": "2026",
    "areaServed": {
      "@type": "Country",
      "name": "Switzerland"
    },
    "sameAs": []
  }
  </script>

  <link rel="stylesheet" href="/public/landing.css">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
</head>
<body>

  <!-- ==================== NAVIGATION ==================== -->
  <nav class="nav" id="nav" role="navigation" aria-label="Main navigation">
    <div class="nav__inner">
      <a href="/" class="nav__logo" aria-label="SwapMart home">
        <span class="nav__logo-icon">&#x1F501;</span>
        Swap<span>Mart</span>
      </a>

      <div class="nav__links">
        <a href="/" class="nav__link">Home</a>
        <a href="#categories" class="nav__link">Categories</a>
        <a href="/listings" class="nav__link">Browse</a>
        <a href="#how-it-works" class="nav__link">How It Works</a>
        <a href="#pricing" class="nav__link">Pricing</a>
        <% if (user) { %>
          <a href="/listings/new" class="nav__link">Sell / Swap</a>
          <a href="/offers" class="nav__link">Offers</a>
          <a href="/messages" class="nav__link">Messages</a>
        <% } %>
      </div>

      <div class="nav__actions">
        <% if (user) { %>
          <a href="/profile/<%= user.id %>" class="btn btn--sm btn--outline"><%= user.username %></a>
          <a href="/auth/logout" class="btn btn--sm btn--primary">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn--sm btn--outline">Login</a>
          <a href="/auth/register" class="btn btn--sm btn--primary">Register</a>
        <% } %>
        <div class="lang-dropdown">
          <button type="button" class="lang-dropdown__btn" aria-expanded="false" aria-haspopup="true">
            &#127760; <span class="lang-dropdown__current">EN</span> &#9662;
          </button>
          <ul class="lang-dropdown__menu" role="menu">
            <li><a href="/" role="menuitem" class="active">English</a></li>
            <li><a href="/" role="menuitem">Deutsch</a></li>
            <li><a href="/" role="menuitem">Fran&ccedil;ais</a></li>
            <li><a href="/" role="menuitem">Italiano</a></li>
          </ul>
        </div>
        <button type="button" class="nav__burger" id="burger" aria-label="Toggle mobile menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="nav__mobile" id="mobileMenu" role="menu">
      <a href="/" role="menuitem">Home</a>
      <a href="#categories" role="menuitem">Categories</a>
      <a href="/listings" role="menuitem">Browse</a>
      <a href="#how-it-works" role="menuitem">How It Works</a>
      <a href="#pricing" role="menuitem">Pricing</a>
      <% if (user) { %>
        <a href="/listings/new" role="menuitem">Sell / Swap</a>
        <a href="/offers" role="menuitem">Offers</a>
        <a href="/messages" role="menuitem">Messages</a>
        <a href="/profile/<%= user.id %>" role="menuitem">My Profile</a>
        <a href="/auth/logout" class="btn btn--primary">Logout</a>
      <% } else { %>
        <a href="/auth/login" role="menuitem">Login</a>
        <a href="/auth/register" class="btn btn--primary">Create Account</a>
      <% } %>
    </div>
  </nav>

  <!-- ==================== HERO ==================== -->
  <header class="hero">
    <div class="container">
      <div class="hero__badge">&#127464;&#127469; Made in Switzerland</div>
      <h1 class="hero__title">
        Trade. Swap. Save.<br>
        <em>Switzerland's <span class="highlight">Fairest</span> Marketplace.</em>
      </h1>
      <p class="hero__subtitle">
        From 4% on cars and real estate, 5% on small items. Always cheaper than Ricardo. Swap items directly, mix cash + barter, or sell the classic way. 3 free listings every month.
      </p>

      <form class="hero__search" action="/listings" method="GET">
        <input type="search" name="q" placeholder="Search Pokemon cards, furniture, apartments, cars..." aria-label="Search listings">
        <button type="submit">Search</button>
      </form>

      <div class="hero__ctas">
        <a href="/auth/register" class="btn btn--primary btn--lg">&#x1F501; Start Trading</a>
        <a href="/listings" class="btn btn--accent btn--lg">Browse Listings</a>
      </div>

      <div class="hero__trust">
        <div class="hero__trust-item">&#x2705; From <strong>4% fees</strong></div>
        <div class="hero__trust-item">&#x1F4E6; Swiss Post integration</div>
        <div class="hero__trust-item">&#x1F91D; Barter &amp; swap</div>
        <div class="hero__trust-item">&#x1F512; Secure trades</div>
      </div>
    </div>
  </header>

  <!-- ==================== STATS BAR ==================== -->
  <section class="stats-bar" aria-label="Platform statistics">
    <div class="container">
      <div class="stats-bar__inner">
        <div class="stats-bar__item">
          <div class="stats-bar__value">10,000+</div>
          <div class="stats-bar__label">Active Listings</div>
        </div>
        <div class="stats-bar__item">
          <div class="stats-bar__value">5,000+</div>
          <div class="stats-bar__label">Happy Traders</div>
        </div>
        <div class="stats-bar__item">
          <div class="stats-bar__value">CHF 2M+</div>
          <div class="stats-bar__label">Total Traded</div>
        </div>
        <div class="stats-bar__item">
          <div class="stats-bar__value">0%</div>
          <div class="stats-bar__label">Barter Fee</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHY SWAPMART ==================== -->
  <section class="section" id="comparison">
    <div class="container">
      <h2 class="section__title">Why SwapMart?</h2>
      <p class="section__subtitle">See how we compare to Switzerland's largest marketplace. Lower fees, more flexibility, and a unique barter system.</p>

      <div class="comparison">
        <table class="comparison__table" role="table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col" class="comparison__ours">&#x1F501; SwapMart</th>
              <th scope="col">Ricardo.ch</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Selling Commission</td>
              <td class="comparison__ours">4&ndash;8% (tiered)</td>
              <td>8&ndash;12% (max CHF 290)</td>
            </tr>
            <tr>
              <td>Monthly Free Listings</td>
              <td class="comparison__ours">3 free</td>
              <td>Varies</td>
            </tr>
            <tr>
              <td>Barter / Swap</td>
              <td class="comparison__ours"><span class="comparison__check">&#x2713;</span> Yes</td>
              <td><span class="comparison__cross">&#x2717;</span> No</td>
            </tr>
            <tr>
              <td>Swap + Cash Deals</td>
              <td class="comparison__ours"><span class="comparison__check">&#x2713;</span> Yes</td>
              <td><span class="comparison__cross">&#x2717;</span> No</td>
            </tr>
            <tr>
              <td>Money Guard</td>
              <td class="comparison__ours">Free</td>
              <td>Mandatory (paid)</td>
            </tr>
            <tr>
              <td>Max Commission Cap</td>
              <td class="comparison__ours">CHF 250</td>
              <td>CHF 290</td>
            </tr>
            <tr>
              <td>Local Pickup</td>
              <td class="comparison__ours"><span class="comparison__check">&#x2713;</span> Built-in</td>
              <td>Limited</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="comparison__note">* Commission rates as of 2026. Ricardo.ch 8-12% (max CHF 290), Tutti.ch free but limited features, eBay 10-13%. Fee examples: CHF 50 item = CHF 2.50 fee, CHF 1,000 item = CHF 50 fee, CHF 10,000 item = CHF 250 (capped).</p>
    </div>
  </section>

  <!-- ==================== CATEGORIES ==================== -->
  <section class="section section--alt" id="categories">
    <div class="container">
      <h2 class="section__title">Popular Categories</h2>
      <p class="section__subtitle">From Pokemon cards to apartments. Find (or trade) almost anything.</p>

      <div class="categories__grid">
        <a href="/listings?category=trading-cards" class="category-card">
          <div class="category-card__icon">&#127183;</div>
          <div class="category-card__name">Trading Cards</div>
          <div class="category-card__count">2,400+ listings</div>
        </a>
        <a href="/listings?category=electronics" class="category-card">
          <div class="category-card__icon">&#128187;</div>
          <div class="category-card__name">Electronics</div>
          <div class="category-card__count">1,800+ listings</div>
        </a>
        <a href="/listings?category=cars-vehicles" class="category-card">
          <div class="category-card__icon">&#128663;</div>
          <div class="category-card__name">Cars &amp; Vehicles</div>
          <div class="category-card__count">950+ listings</div>
        </a>
        <a href="/listings?category=apartments-rooms" class="category-card">
          <div class="category-card__icon">&#127969;</div>
          <div class="category-card__name">Apartments &amp; Rooms</div>
          <div class="category-card__count">620+ listings</div>
        </a>
        <a href="/listings?category=fashion" class="category-card">
          <div class="category-card__icon">&#128087;</div>
          <div class="category-card__name">Fashion</div>
          <div class="category-card__count">1,500+ listings</div>
        </a>
        <a href="/listings?category=furniture" class="category-card">
          <div class="category-card__icon">&#128717;</div>
          <div class="category-card__name">Furniture</div>
          <div class="category-card__count">870+ listings</div>
        </a>
        <a href="/listings?category=sports-outdoors" class="category-card">
          <div class="category-card__icon">&#9917;</div>
          <div class="category-card__name">Sports &amp; Outdoors</div>
          <div class="category-card__count">1,100+ listings</div>
        </a>
        <a href="/listings?category=collectibles" class="category-card">
          <div class="category-card__icon">&#127942;</div>
          <div class="category-card__name">Collectibles</div>
          <div class="category-card__count">760+ listings</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== HOW IT WORKS ==================== -->
  <section class="section" id="how-it-works">
    <div class="container">
      <h2 class="section__title">How Swapping Works</h2>
      <p class="section__subtitle">Four simple steps to trade, swap, or sell. No complicated processes.</p>

      <div class="steps">
        <div class="step">
          <div class="step__number">1</div>
          <div class="step__icon">&#128248;</div>
          <h3 class="step__title">List Your Item</h3>
          <p class="step__desc">Snap a photo, set a price or mark it "Open to Swaps". First 3 listings each month are free.</p>
        </div>
        <div class="step">
          <div class="step__number">2</div>
          <div class="step__icon">&#128269;</div>
          <h3 class="step__title">Browse &amp; Find</h3>
          <p class="step__desc">Search by category, location, or swap preference. Filter for barter-friendly listings.</p>
        </div>
        <div class="step">
          <div class="step__number">3</div>
          <div class="step__icon">&#129309;</div>
          <h3 class="step__title">Propose a Deal</h3>
          <p class="step__desc">Offer cash, a swap, or a mix of both. "My PS5 + CHF 200 for your Gaming PC". It all works.</p>
          <div class="step__badge">Swap + Cash</div>
        </div>
        <div class="step">
          <div class="step__number">4</div>
          <div class="step__icon">&#127881;</div>
          <h3 class="step__title">Meet &amp; Trade</h3>
          <p class="step__desc">Ship via Swiss Post or meet locally. Rate your trading partner and build your reputation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED LISTINGS (dynamic from DB) ==================== -->
  <section class="section section--alt" id="listings">
    <div class="container">
      <h2 class="section__title">Latest Listings</h2>
      <p class="section__subtitle">Fresh picks from our community. See something you like? Make an offer.</p>

      <!-- Filter Tabs -->
      <div style="display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; justify-content: center;">
        <a href="/?#listings" class="btn <%= (typeof activeFilter === 'undefined' || !activeFilter) && (typeof activeType === 'undefined' || !activeType) ? 'btn--primary' : 'btn--outline' %> btn--sm" style="border-radius: 999px;">All</a>
        <a href="/?type=sell#listings" class="btn <%= (typeof activeType !== 'undefined' && activeType === 'sell') ? 'btn--primary' : 'btn--outline' %> btn--sm" style="border-radius: 999px;">For Sale</a>
        <a href="/?type=swap#listings" class="btn <%= (typeof activeType !== 'undefined' && activeType === 'swap') ? 'btn--primary' : 'btn--outline' %> btn--sm" style="border-radius: 999px;">For Swap</a>
        <a href="/?type=both#listings" class="btn <%= (typeof activeType !== 'undefined' && activeType === 'both') ? 'btn--primary' : 'btn--outline' %> btn--sm" style="border-radius: 999px;">Swap + Cash</a>
        <a href="/?mode=auction#listings" class="btn <%= (typeof activeFilter !== 'undefined' && activeFilter === 'auction') ? 'btn--accent' : 'btn--outline' %> btn--sm" style="border-radius: 999px;">&#128276; Auctions</a>
      </div>

      <% if (featured.length > 0) { %>
        <div class="listings__grid">
          <% featured.forEach(function(listing) { %>
            <a href="/listings/<%= listing.slug || listing.id %>" style="text-decoration:none; color:inherit;">
              <article class="listing-card">
                <% if (listing.image) { %>
                  <div class="listing-card__img" style="position: relative;">
                    <img src="/uploads/<%= listing.image %>" alt="<%= listing.title %>" style="width:100%; height:100%; object-fit:cover;">
                    <% if (listing.listing_mode === 'auction') { %>
                      <span class="listing-card__badge" style="background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #111; font-weight: 700; top: 8px; left: 8px; right: auto;">Auction</span>
                    <% } %>
                    <% if (listing.type === 'swap') { %>
                      <span class="listing-card__badge listing-card__badge--swap">Open to Swaps</span>
                    <% } else if (listing.type === 'both') { %>
                      <span class="listing-card__badge listing-card__badge--cash">Sell / Swap</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="listing-card__img" aria-label="<%= listing.title %>" style="position: relative;">
                    <% const catIcons = { 'Trading Cards': '&#127183;', 'Electronics': '&#128187;', 'Cars & Vehicles': '&#128663;', 'Apartments & Housing': '&#127968;', 'Fashion': '&#128085;', 'Furniture': '&#128715;', 'Sports': '&#127942;', 'Collectibles': '&#128142;' }; %>
                    <%- catIcons[listing.category_name] || '&#128230;' %>
                    <% if (listing.listing_mode === 'auction') { %>
                      <span class="listing-card__badge" style="background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #111; font-weight: 700; top: 8px; left: 8px; right: auto;">Auction</span>
                    <% } %>
                    <% if (listing.type === 'swap') { %>
                      <span class="listing-card__badge listing-card__badge--swap">Open to Swaps</span>
                    <% } else if (listing.type === 'both') { %>
                      <span class="listing-card__badge listing-card__badge--cash">Sell / Swap</span>
                    <% } %>
                  </div>
                <% } %>
                <div class="listing-card__body">
                  <h3 class="listing-card__title"><%= listing.title %></h3>
                  <p class="listing-card__meta"><%= listing.category_name %> &middot; <%= listing.seller_name %></p>
                  <% if (listing.listing_mode === 'auction') { %>
                    <div class="listing-card__price" style="display: flex; justify-content: space-between; align-items: center;">
                      <span>
                        <% if (listing.current_bid) { %>
                          CHF <%= parseFloat(listing.current_bid).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                        <% } else { %>
                          From CHF <%= parseFloat(listing.starting_price).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                        <% } %>
                      </span>
                      <span style="font-size: 0.75rem; font-weight: 500; opacity: 0.7;"><%= listing.bid_count || 0 %> bid<%= listing.bid_count != 1 ? 's' : '' %></span>
                    </div>
                    <% if (listing.auction_end) { %>
                      <div class="listing-card__countdown" data-end="<%= new Date(listing.auction_end).toISOString() %>"
                           style="font-size: 0.75rem; color: var(--amber-600); font-weight: 600; margin-top: 4px;">...</div>
                    <% } %>
                  <% } else if (listing.price) { %>
                    <div class="listing-card__price">CHF <%= parseFloat(listing.price).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %></div>
                  <% } else { %>
                    <div class="listing-card__swap-label">&#x1F501; Open to Swaps</div>
                  <% } %>
                </div>
              </article>
            </a>
          <% }); %>
        </div>
        <div style="text-align: center; margin-top: 32px;">
          <a href="/listings" class="btn btn--outline">View All Listings</a>
        </div>
      <% } else { %>
        <!-- Static showcase listings when DB is empty -->
        <div class="listings__grid">
          <article class="listing-card">
            <div class="listing-card__img" aria-label="Pokemon Charizard Holo card">
              &#127183;
              <span class="listing-card__badge listing-card__badge--swap">Open to Swaps</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">Pokemon Charizard Holo 1st Ed.</h3>
              <p class="listing-card__meta">Trading Cards &middot; Zurich</p>
              <div class="listing-card__price">CHF 1,200</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 4.9 &middot; 23 trades</span>
              <span>2h ago</span>
            </div>
          </article>

          <article class="listing-card">
            <div class="listing-card__img" aria-label="BMW 320i car">
              &#128663;
              <span class="listing-card__badge listing-card__badge--cash">Swap + Cash</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">BMW 320i 2019 &middot; 68k km</h3>
              <p class="listing-card__meta">Cars &amp; Vehicles &middot; Bern</p>
              <div class="listing-card__price">CHF 22,500</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 4.7 &middot; 8 trades</span>
              <span>5h ago</span>
            </div>
          </article>

          <article class="listing-card">
            <div class="listing-card__img" aria-label="3-room apartment in Zurich">
              &#127969;
              <span class="listing-card__badge listing-card__badge--new">New</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">3-Room Apartment &middot; Zurich Oerlikon</h3>
              <p class="listing-card__meta">Apartments &amp; Rooms &middot; Zurich</p>
              <div class="listing-card__price">CHF 1,950/mo</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 5.0 &middot; Verified</span>
              <span>1d ago</span>
            </div>
          </article>

          <article class="listing-card">
            <div class="listing-card__img" aria-label="PS5 gaming console bundle">
              &#127918;
              <span class="listing-card__badge listing-card__badge--swap">Open to Swaps</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">PS5 Bundle &middot; 2 Controllers + 5 Games</h3>
              <p class="listing-card__meta">Electronics &middot; Basel</p>
              <div class="listing-card__swap-label">&#x1F501; Open to Swaps</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 4.8 &middot; 15 trades</span>
              <span>3h ago</span>
            </div>
          </article>

          <article class="listing-card">
            <div class="listing-card__img" aria-label="Vintage Rolex Submariner watch">
              &#9201;
              <span class="listing-card__badge listing-card__badge--cash">Swap + Cash</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">Vintage Rolex Submariner 1985</h3>
              <p class="listing-card__meta">Collectibles &middot; Geneva</p>
              <div class="listing-card__price">CHF 8,900</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 5.0 &middot; 41 trades</span>
              <span>6h ago</span>
            </div>
          </article>

          <article class="listing-card">
            <div class="listing-card__img" aria-label="Yu-Gi-Oh Blue-Eyes White Dragon card">
              &#128293;
              <span class="listing-card__badge listing-card__badge--swap">Open to Swaps</span>
            </div>
            <div class="listing-card__body">
              <h3 class="listing-card__title">Yu-Gi-Oh Blue-Eyes White Dragon 1st Ed.</h3>
              <p class="listing-card__meta">Trading Cards &middot; Lugano</p>
              <div class="listing-card__price">CHF 450</div>
            </div>
            <div class="listing-card__footer">
              <span>&#11088; 4.6 &middot; 12 trades</span>
              <span>8h ago</span>
            </div>
          </article>
        </div>
        <div style="text-align: center; margin-top: 32px;">
          <a href="/listings" class="btn btn--outline">View All Listings</a>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ==================== HOUSING & REAL ESTATE ==================== -->
  <section class="section" id="housing">
    <div class="container">
      <h2 class="section__title">Housing &amp; Real Estate</h2>
      <p class="section__subtitle">Find your next home or list your property. Apartments, rooms, houses, and commercial spaces across Switzerland.</p>

      <div class="listings__grid">
        <article class="listing-card">
          <div class="listing-card__img" aria-label="Studio apartment Zurich">&#127969;<span class="listing-card__badge listing-card__badge--new">New</span></div>
