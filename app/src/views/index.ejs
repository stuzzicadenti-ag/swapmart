<%- include('partials/header', { pageTitle: 'Home', user }) %>

<!-- Hero -->
<section style="background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: #fff; padding: 3.5rem 0;">
  <div class="container text-center">
    <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;">
      Buy. Sell. <span style="color: var(--amber);">Swap.</span>
    </h1>
    <p style="font-size: 1.15rem; opacity: 0.9; max-width: 500px; margin: 0 auto 1.5rem;">
      The Swiss marketplace for trading anything - from trading cards to cars. No middlemen, fair commissions.
    </p>
    <form action="/listings" method="GET" style="max-width: 500px; margin: 0 auto; display: flex; gap: 0.5rem;">
      <input type="text" name="q" class="form-control" placeholder="Search listings..." style="flex: 1; padding: 0.75rem 1rem; font-size: 1rem;">
      <button type="submit" class="btn btn-amber" style="padding: 0.75rem 1.5rem;">Search</button>
    </form>
  </div>
</section>

<!-- Categories -->
<section class="py-4">
  <div class="container">
    <h2 class="mb-2" style="font-size: 1.5rem;">Browse Categories</h2>
    <div class="grid grid-4">
      <% categories.forEach(cat => { %>
        <a href="/listings?category=<%= cat.slug %>" class="card" style="text-decoration: none;">
          <div class="card-body text-center" style="padding: 1.25rem;">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">
              <% const icons = { cards: '&#127183;', cpu: '&#128187;', car: '&#128663;', home: '&#127968;', shirt: '&#128085;', sofa: '&#128715;', trophy: '&#127942;', gem: '&#128142;' }; %>
              <%- icons[cat.icon] || '&#128230;' %>
            </div>
            <div style="font-weight: 600; color: var(--text);"><%= cat.name %></div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Listings -->
<section class="py-3">
  <div class="container">
    <div class="flex-between mb-2">
      <h2 style="font-size: 1.5rem;">Latest Listings</h2>
      <a href="/listings" class="btn btn-outline btn-sm">View All</a>
    </div>
    <% if (featured.length === 0) { %>
      <div class="card">
        <div class="card-body text-center py-4">
          <p class="text-light">No listings yet. <a href="/listings/new">Be the first to list!</a></p>
        </div>
      </div>
    <% } else { %>
      <div class="grid grid-4">
        <% featured.forEach(listing => { %>
          <a href="/listings/<%= listing.id %>" class="card" style="text-decoration: none;">
            <% if (listing.image) { %>
              <img src="/uploads/<%= listing.image %>" alt="<%= listing.title %>" class="listing-img" loading="lazy">
            <% } else { %>
              <div class="listing-img-placeholder">
                <% const catIcons = { 'Trading Cards': '&#127183;', 'Electronics': '&#128187;', 'Cars & Vehicles': '&#128663;', 'Apartments & Housing': '&#127968;', 'Fashion': '&#128085;', 'Furniture': '&#128715;', 'Sports': '&#127942;', 'Collectibles': '&#128142;' }; %>
                <%- catIcons[listing.category_name] || '&#128230;' %>
              </div>
            <% } %>
            <div class="card-body">
              <div class="flex-between mb-1">
                <span class="badge badge-primary"><%= listing.category_name %></span>
                <% if (listing.type === 'swap') { %>
                  <span class="badge badge-amber">Swap</span>
                <% } else if (listing.type === 'both') { %>
                  <span class="badge badge-amber">Sell / Swap</span>
                <% } %>
              </div>
              <h3 style="font-size: 0.95rem; font-weight: 600; color: var(--text); margin-bottom: 0.35rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                <%= listing.title %>
              </h3>
              <div class="flex-between">
                <% if (listing.price) { %>
                  <span style="font-weight: 700; color: var(--primary); font-size: 1.05rem;">
                    CHF <%= parseFloat(listing.price).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                  </span>
                <% } else { %>
                  <span class="badge badge-amber">Swap Only</span>
                <% } %>
                <span class="text-sm text-light"><%= listing.seller_name %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- Commission info -->
<section class="py-4">
  <div class="container">
    <div class="card" style="border: 2px solid var(--primary-light);">
      <div class="card-body" style="padding: 2rem;">
        <h2 class="text-center mb-2" style="font-size: 1.5rem;">Fair & Transparent Fees</h2>
        <p class="text-center text-light mb-2">Pure barter trades are always <strong style="color: var(--primary);">FREE</strong>. Cash transactions have simple tiered commissions:</p>
        <div class="grid grid-4" style="text-align: center;">
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">5%</div>
            <div class="text-sm text-light">Under CHF 50</div>
          </div>
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">8%</div>
            <div class="text-sm text-light">CHF 50 - 999</div>
          </div>
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">6%</div>
            <div class="text-sm text-light">CHF 1,000 - 9,999</div>
          </div>
          <div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">4%</div>
            <div class="text-sm text-light">CHF 10,000+</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
