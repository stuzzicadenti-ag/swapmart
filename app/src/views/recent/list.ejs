<%- include('../partials/header', { pageTitle: t('recently_viewed.title'), user }) %>

<section class="py-3">
  <div class="container">
    <h1 class="section-heading mb-1"><%= t('recently_viewed.title') %></h1>
    <p class="section-subheading mb-2"><%= t('recently_viewed.subtitle') %></p>

    <% if (listings.length === 0) { %>
      <div class="card card--no-hover">
        <div class="empty-state">
          <div class="empty-state__icon">&#128065;</div>
          <div class="empty-state__title"><%= t('recently_viewed.empty_title') %></div>
          <div class="empty-state__text"><%= t('recently_viewed.empty_text') %></div>
          <a href="/listings" class="btn btn--primary btn--sm"><%= t('nav.browse') %></a>
        </div>
      </div>
    <% } else { %>
      <div class="grid grid-4">
        <% listings.forEach(listing => { %>
          <a href="/listings/<%= listing.slug || listing.id %>" class="listing-card-link">
            <div class="card card--interactive">
              <div class="listing-img-wrap">
                <% if (listing.image) { %>
                  <img src="/uploads/<%= listing.image %>" alt="<%= listing.title %>" class="listing-img" loading="lazy">
                <% } else { %>
                  <div class="listing-img-placeholder">&#128230;</div>
                <% } %>
                <% if (listing.status !== 'active') { %>
                  <div style="position: absolute; top: 8px; right: 8px;">
                    <span class="badge badge-danger"><%= listing.status %></span>
                  </div>
                <% } %>
              </div>
              <div class="card-body">
                <span class="badge badge-primary mb-1" style="align-self: flex-start;"><%= listing.category_name %></span>
                <h3 class="listing-card__title"><%= listing.title %></h3>
                <div class="flex-between mt-1">
                  <% if (listing.price) { %>
                    <span class="price-tag--sm">
                      CHF <%= parseFloat(listing.price).toLocaleString('de-CH') %>
                    </span>
                  <% } else { %>
                    <span class="badge badge-amber">Swap</span>
                  <% } %>
                  <span class="text-xs text-light"><%= listing.seller_name %></span>
                </div>
                <div class="text-xs text-light mt-1">
                  <%= t('recently_viewed.viewed') %> <%= new Date(listing.viewed_at).toLocaleString('en-CH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
