<%- include('../partials/header', { pageTitle: 'Admin - User Warnings', user }) %>

<style>
  .admin-layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - var(--nav-h)); }
  .admin-sidebar { background: var(--gray-900); padding: 1.5rem 0; position: sticky; top: var(--nav-h); height: calc(100vh - var(--nav-h)); overflow-y: auto; }
  .admin-sidebar__logo { padding: 0 1.25rem 1.25rem; border-bottom: 1px solid var(--gray-700); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; color: var(--white); font-weight: 700; font-size: 1.1rem; }
  .admin-sidebar__logo span { color: var(--amber-400); }
  .admin-nav { list-style: none; padding: 0; }
  .admin-nav a { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1.25rem; color: var(--gray-400); font-size: 0.9rem; font-weight: 500; transition: all 0.15s; text-decoration: none; border-left: 3px solid transparent; }
  .admin-nav a:hover, .admin-nav a.active { background: rgba(255,255,255,0.05); color: var(--white); border-left-color: var(--primary); }
  .admin-content { padding: 1.5rem 2rem; background: var(--bg-alt); min-width: 0; }
  .admin-content h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .admin-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--gray-50); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-light); border-bottom: 2px solid var(--border); }
  .admin-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .warn-expired { opacity: 0.5; text-decoration: line-through; }
</style>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar__logo"><span>SM</span> Admin</div>
    <ul class="admin-nav">
      <li><a href="/admin"><span class="admin-nav__icon">&#9632;</span> Dashboard</a></li>
      <li><a href="/admin/users" class="active"><span class="admin-nav__icon">&#9679;</span> Users</a></li>
      <li><a href="/admin/listings"><span class="admin-nav__icon">&#9632;</span> Listings</a></li>
      <li><a href="/admin/flags"><span class="admin-nav__icon">&#9873;</span> Flags</a></li>
      <li><a href="/admin/kyc"><span class="admin-nav__icon">&#9745;</span> KYC</a></li>
      <li><a href="/admin/logs"><span class="admin-nav__icon">&#9776;</span> Logs</a></li>
    </ul>
  </aside>
  <main class="admin-content">
    <a href="/admin/users" style="font-size: 0.85rem; color: var(--primary); margin-bottom: 0.5rem; display: inline-block;">&larr; Back to Users</a>
    <h1>Warnings: <%= targetUser.username || targetUser.name %></h1>
    <p style="color: var(--text-light); margin-bottom: 1.5rem;"><%= targetUser.email %> <% if (targetUser.banned) { %><span style="color: var(--danger); font-weight: 600;">BANNED</span><% } %></p>

    <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
      <div style="background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.5rem; text-align: center; min-width: 140px;">
        <div style="font-size: 2rem; font-weight: 700; color: var(--amber-500);"><%= warnings.filter(w => !w.expired).length %></div>
        <div style="font-size: 0.8rem; color: var(--text-light);">Active Warnings</div>
      </div>
      <div style="background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.5rem; text-align: center; min-width: 140px;">
        <div style="font-size: 2rem; font-weight: 700; color: var(--text-light);"><%= warnings.filter(w => w.expired).length %></div>
        <div style="font-size: 0.8rem; color: var(--text-light);">Expired Warnings</div>
      </div>
    </div>

    <% if (warnings.length === 0) { %>
      <div style="text-align: center; padding: 3rem; color: var(--text-light);">No warnings on record.</div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Reason</th>
            <th>Details</th>
            <th>Issued By</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% warnings.forEach(w => { %>
          <tr class="<%= w.expired ? 'warn-expired' : '' %>">
            <td><%= new Date(w.created_at).toLocaleDateString('en-CH') %></td>
            <td><%= w.reason.replace(/_/g, ' ') %></td>
            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= w.details || '' %></td>
            <td><%= w.admin_name %></td>
            <td>
              <% if (w.expired) { %>
                <span style="color: var(--text-light); font-size: 0.8rem;">Expired</span>
              <% } else { %>
                <span style="color: var(--amber-500); font-weight: 600; font-size: 0.8rem;">Active</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <p style="font-size: 0.8rem; color: var(--text-light); margin-top: 1.5rem;">
      Warnings expire automatically after 6 months of good conduct. 3 active warnings result in automatic account suspension.
    </p>
  </main>
</div>

<%- include('../partials/footer') %>
