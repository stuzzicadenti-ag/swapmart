<%- include('../partials/header', { pageTitle: 'Admin - Users', user }) %>

<style>
  .admin-layout { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - var(--nav-h)); }
  .admin-sidebar { background: var(--gray-900); padding: 1.5rem 0; position: sticky; top: var(--nav-h); height: calc(100vh - var(--nav-h)); overflow-y: auto; }
  .admin-sidebar__logo { padding: 0 1.25rem 1.25rem; border-bottom: 1px solid var(--gray-700); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; color: var(--white); font-weight: 700; font-size: 1.1rem; }
  .admin-sidebar__logo span { color: var(--amber-400); }
  .admin-nav { list-style: none; padding: 0; }
  .admin-nav a { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1.25rem; color: var(--gray-400); font-size: 0.9rem; font-weight: 500; transition: all 0.15s; text-decoration: none; border-left: 3px solid transparent; }
  .admin-nav a:hover, .admin-nav a.active { background: rgba(255,255,255,0.05); color: var(--white); border-left-color: var(--primary); }
  .admin-nav a.active { color: var(--teal-300); }
  .admin-nav__icon { font-size: 1.1rem; width: 1.5rem; text-align: center; }
  .admin-content { padding: 1.5rem 2rem; background: var(--bg-alt); min-width: 0; }
  .admin-content h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .admin-table th { text-align: left; padding: 0.6rem 0.75rem; background: var(--gray-50); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-light); border-bottom: 2px solid var(--border); }
  .admin-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .admin-table tr:hover { background: var(--gray-50); }
  .filter-bar { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: flex-end; }
  .filter-bar .form-group { margin-bottom: 0; }
  .filter-bar .form-control { padding: 0.45rem 0.65rem; font-size: 0.85rem; }
  .role-form { display: inline-flex; gap: 0.25rem; align-items: center; }
  .role-form select { padding: 0.2rem 0.4rem; font-size: 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--border); }
  .role-form button { padding: 0.2rem 0.5rem; font-size: 0.75rem; }
  @media (max-width: 768px) {
    .admin-layout { grid-template-columns: 1fr; }
    .admin-sidebar { position: relative; top: 0; height: auto; display: flex; overflow-x: auto; padding: 0.75rem 0; }
    .admin-sidebar__logo { display: none; }
    .admin-nav { display: flex; gap: 0; white-space: nowrap; }
    .admin-nav a { padding: 0.5rem 1rem; border-left: none; border-bottom: 3px solid transparent; font-size: 0.8rem; }
    .admin-nav a:hover, .admin-nav a.active { border-left-color: transparent; border-bottom-color: var(--primary); }
    .admin-content { padding: 1rem; }
    .admin-table { display: block; overflow-x: auto; }
  }
</style>

<div class="admin-layout">
  <%- include('_sidebar', { activePage: 'users' }) %>

  <div class="admin-content">
    <h1>Users (<%= pagination.total %>)</h1>

    <form class="filter-bar" method="GET" action="/admin/users">
      <div class="form-group">
        <label class="text-sm">Search</label>
        <input type="text" name="q" class="form-control" placeholder="Username, email, name..." value="<%= (filters.q || '') %>">
      </div>
      <div class="form-group">
        <label class="text-sm">Role</label>
        <select name="role" class="form-control">
          <option value="">All</option>
          <option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>User</option>
          <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
          <option value="owner" <%= filters.role === 'owner' ? 'selected' : '' %>>Owner</option>
        </select>
      </div>
      <div class="form-group">
        <label class="text-sm">Banned</label>
        <select name="banned" class="form-control">
          <option value="">All</option>
          <option value="true" <%= filters.banned === 'true' ? 'selected' : '' %>>Banned</option>
          <option value="false" <%= filters.banned === 'false' ? 'selected' : '' %>>Active</option>
        </select>
      </div>
      <button type="submit" class="btn btn--primary btn--sm">Filter</button>
      <a href="/admin/users" class="btn btn--outline btn--sm">Reset</a>
    </form>

    <div class="card" style="overflow: visible;">
      <div style="overflow-x: auto;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Role</th>
              <th>Rep</th>
              <th>Status</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr><td colspan="8" class="text-center text-light" style="padding: 2rem;">No users found.</td></tr>
            <% } %>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.id %></td>
                <td><a href="/profile/<%= u.id %>"><strong><%= u.username %></strong></a></td>
                <td class="text-sm"><%= u.email %></td>
                <td>
                  <span class="badge <%= u.role === 'owner' ? 'badge-amber' : u.role === 'admin' ? 'badge-primary' : 'badge-gray' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td><%= u.reputation_score %></td>
                <td>
                  <% if (u.banned) { %>
                    <span class="badge badge-danger">Banned</span>
                  <% } else { %>
                    <span class="badge badge-success">Active</span>
                  <% } %>
                </td>
                <td class="text-sm text-light"><%= new Date(u.created_at).toLocaleDateString('en-CH') %></td>
                <td>
                  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                    <!-- Role change (only for owners, or admins can set 'user') -->
                    <% if (adminRole === 'owner' || (adminRole === 'admin' && u.role === 'user')) { %>
                      <form action="/admin/users/<%= u.id %>/role" method="POST" class="role-form">
                        <select name="role">
                          <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
                          <% if (adminRole === 'owner') { %>
                            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                            <option value="owner" <%= u.role === 'owner' ? 'selected' : '' %>>owner</option>
                          <% } %>
                        </select>
                        <button type="submit" class="btn btn--outline btn--sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Set</button>
                      </form>
                    <% } %>

                    <!-- Ban/Unban -->
                    <% if (u.id !== user.id) { %>
                      <% if (u.banned) { %>
                        <form action="/admin/users/<%= u.id %>/unban" method="POST" style="display: inline;">
                          <button type="submit" class="btn btn--primary btn--sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Unban</button>
                        </form>
                      <% } else if (u.role !== 'owner' && (adminRole === 'owner' || u.role !== 'admin')) { %>
                        <form action="/admin/users/<%= u.id %>/ban" method="POST" style="display: inline-flex; gap: 0.25rem; align-items: center;"
                              onsubmit="var r = prompt('Ban reason:'); if (!r) return false; this.querySelector('[name=reason]').value = r;">
                          <input type="hidden" name="reason" value="">
                          <button type="submit" class="btn btn-danger btn--sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Ban</button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                  <% if (u.banned && u.banned_reason) { %>
                    <div class="text-sm text-light mt-1" style="font-size: 0.75rem;" title="<%= u.banned_reason %>">
                      Reason: <%= u.banned_reason.substring(0, 50) %><%= u.banned_reason.length > 50 ? '...' : '' %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (pagination.totalPages > 1) { %>
      <div class="pagination">
        <% if (pagination.page > 1) { %>
          <a href="/admin/users?page=<%= pagination.page - 1 %>&q=<%= filters.q || '' %>&role=<%= filters.role || '' %>&banned=<%= filters.banned || '' %>">&laquo; Prev</a>
        <% } %>
        <span class="text-sm text-light">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
        <% if (pagination.page < pagination.totalPages) { %>
          <a href="/admin/users?page=<%= pagination.page + 1 %>&q=<%= filters.q || '' %>&role=<%= filters.role || '' %>&banned=<%= filters.banned || '' %>">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
