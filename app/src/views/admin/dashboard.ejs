<%- include('../partials/header', { pageTitle: 'Admin Dashboard', user }) %>

<style>
  .admin-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - var(--nav-h));
  }
  .admin-sidebar {
    background: var(--gray-900);
    padding: 1.5rem 0;
    position: sticky;
    top: var(--nav-h);
    height: calc(100vh - var(--nav-h));
    overflow-y: auto;
  }
  .admin-sidebar__logo {
    padding: 0 1.25rem 1.25rem;
    border-bottom: 1px solid var(--gray-700);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--white);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .admin-sidebar__logo span { color: var(--amber-400); }
  .admin-nav { list-style: none; padding: 0; }
  .admin-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.25rem;
    color: var(--gray-400);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.15s;
    text-decoration: none;
    border-left: 3px solid transparent;
  }
  .admin-nav a:hover, .admin-nav a.active {
    background: rgba(255,255,255,0.05);
    color: var(--white);
    border-left-color: var(--primary);
  }
  .admin-nav a.active { color: var(--teal-300); }
  .admin-nav__icon { font-size: 1.1rem; width: 1.5rem; text-align: center; }
  .admin-content { padding: 1.5rem 2rem; background: var(--bg-alt); min-width: 0; }
  .admin-content h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .stat-card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.25rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .stat-card__label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-light); margin-bottom: 0.25rem; }
  .stat-card__value { font-size: 1.75rem; font-weight: 800; color: var(--text-dark); }
  .stat-card__value--primary { color: var(--primary); }
  .stat-card__value--amber { color: var(--amber-600); }
  .stat-card__value--danger { color: var(--danger); }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .admin-table th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    background: var(--gray-50);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-light);
    border-bottom: 2px solid var(--border);
  }
  .admin-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .admin-table tr:hover { background: var(--gray-50); }
  @media (max-width: 768px) {
    .admin-layout { grid-template-columns: 1fr; }
    .admin-sidebar {
      position: relative;
      top: 0;
      height: auto;
      display: flex;
      overflow-x: auto;
      padding: 0.75rem 0;
    }
    .admin-sidebar__logo { display: none; }
    .admin-nav { display: flex; gap: 0; white-space: nowrap; }
    .admin-nav a { padding: 0.5rem 1rem; border-left: none; border-bottom: 3px solid transparent; font-size: 0.8rem; }
    .admin-nav a:hover, .admin-nav a.active { border-left-color: transparent; border-bottom-color: var(--primary); }
    .admin-content { padding: 1rem; }
    .stat-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<div class="admin-layout">
  <%- include('_sidebar', { activePage: 'dashboard' }) %>

  <div class="admin-content">
    <h1>Dashboard</h1>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-card__label">Total Users</div>
        <div class="stat-card__value"><%= stats.users %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Active Listings</div>
        <div class="stat-card__value stat-card__value--primary"><%= stats.listings %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Total Revenue</div>
        <div class="stat-card__value stat-card__value--amber">CHF <%= stats.revenue.toFixed(2) %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card__label">Pending Flags</div>
        <div class="stat-card__value stat-card__value--danger"><%= stats.pendingFlags %></div>
      </div>
    </div>

    <% if (stats.pendingKyc > 0) { %>
      <div class="alert alert-warning mb-2" style="display: flex; align-items: center; justify-content: space-between;">
        <span><strong><%= stats.pendingKyc %></strong> KYC submission<%= stats.pendingKyc !== 1 ? 's' : '' %> pending review</span>
        <a href="/admin/kyc" class="btn btn--accent btn--sm">Review</a>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
      <!-- Recent Flags -->
      <div class="card" style="overflow: visible;">
        <div class="card-body" style="padding: 1.25rem;">
          <div class="flex-between mb-2">
            <h2 style="font-size: 1.1rem; font-weight: 600;">Recent Flags</h2>
            <a href="/admin/flags" class="text-sm">View all</a>
          </div>
          <% if (recentFlags.length === 0) { %>
            <p class="text-light text-sm">No flags yet.</p>
          <% } else { %>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Listing</th>
                  <th>Status</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% recentFlags.forEach(f => { %>
                  <tr>
                    <td>
                      <span class="badge <%= f.type.startsWith('auto_') ? 'badge-amber' : 'badge-danger' %>"><%= f.type.replace('auto_', '') %></span>
                    </td>
                    <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <%= f.listing_title || 'N/A' %>
                    </td>
                    <td>
                      <span class="badge <%= f.status === 'pending' ? 'badge-amber' : f.status === 'dismissed' ? 'badge-gray' : 'badge-success' %>"><%= f.status %></span>
                    </td>
                    <td class="text-sm text-light"><%= new Date(f.created_at).toLocaleDateString('en-CH') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>

      <!-- Recent Transactions -->
      <div class="card" style="overflow: visible;">
        <div class="card-body" style="padding: 1.25rem;">
          <div class="flex-between mb-2">
            <h2 style="font-size: 1.1rem; font-weight: 600;">Recent Transactions</h2>
          </div>
          <% if (recentTransactions.length === 0) { %>
            <p class="text-light text-sm">No transactions yet.</p>
          <% } else { %>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Listing</th>
                  <th>Buyer</th>
                  <th>Amount</th>
                  <th>Commission</th>
                </tr>
              </thead>
              <tbody>
                <% recentTransactions.forEach(t => { %>
                  <tr>
                    <td style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <%= t.listing_title %>
                    </td>
                    <td><%= t.buyer_name %></td>
                    <td>CHF <%= parseFloat(t.amount).toFixed(2) %></td>
                    <td style="color: var(--amber-600); font-weight: 600;">CHF <%= parseFloat(t.commission).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
