<%- include('../partials/header', { pageTitle: t('banned.title'), user: null }) %>

<section class="py-4">
  <div class="container" style="max-width: 560px;">
    <div class="text-center mb-3">
      <div style="width: 80px; height: 80px; border-radius: 50%; background: #fef2f2; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--gray-900); margin-bottom: 0.5rem;"><%= t('banned.title') %></h1>
      <p class="text-light" style="font-size: 1.05rem;"><%= t('banned.subtitle') %></p>
    </div>

    <% if (reason) { %>
      <div class="card mb-3" style="border: 1px solid #fecaca; background: #fef2f2;">
        <div class="card-body" style="padding: 1.25rem;">
          <div style="font-weight: 700; font-size: 0.875rem; color: #991b1b; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.04em;"><%= t('banned.reason') %></div>
          <p style="color: #7f1d1d; font-size: 0.9375rem; line-height: 1.6;"><%= reason %></p>
        </div>
      </div>
    <% } %>

    <div class="card mb-3">
      <div class="card-body" style="padding: 1.5rem;">
        <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem;"><%= t('banned.what_to_do') %></h2>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="flex-center gap-2">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--teal-100); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.875rem; font-weight: 700;">1</div>
            <div>
              <div style="font-weight: 600; font-size: 0.9375rem;"><%= t('banned.contact_support') %></div>
              <p class="text-sm text-light"><%= t('banned.contact_desc') %> <a href="mailto:support@swapmart.ch" style="font-weight: 600;">support@swapmart.ch</a></p>
            </div>
          </div>

          <div class="flex-center gap-2">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--teal-100); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.875rem; font-weight: 700;">2</div>
            <div>
              <div style="font-weight: 600; font-size: 0.9375rem;"><%= t('banned.review_policies') %></div>
              <p class="text-sm text-light"><%- t('banned.review_desc') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center">
      <a href="/faq" class="btn btn--outline" style="margin-right: 0.5rem;"><%= t('btn.read_faq') %></a>
      <a href="/" class="btn btn--primary"><%= t('btn.back_to_home') %></a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
