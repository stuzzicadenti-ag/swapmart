<%- include('../partials/header', { pageTitle: t('analytics.title'), user }) %>

<section class="py-3">
  <div class="container">
    <a href="/listings/<%= listing.slug || listing.id %>" class="text-sm text-light" style="display: inline-block; margin-bottom: 1rem;">&larr; <%= t('analytics.back_to_listing') %></a>

    <h1 class="section-heading mb-1"><%= t('analytics.title') %></h1>
    <p class="section-subheading mb-2"><%= listing.title %></p>

    <!-- Stats Cards -->
    <div class="grid grid-4 mb-3">
      <div class="card">
        <div class="card-body text-center">
          <div style="font-size: 2rem; font-weight: 800; color: var(--primary);"><%= stats.totalViews %></div>
          <div class="text-sm text-light"><%= t('analytics.total_views') %></div>
        </div>
      </div>
      <div class="card">
        <div class="card-body text-center">
          <div style="font-size: 2rem; font-weight: 800; color: var(--teal-600);"><%= stats.uniqueViewers %></div>
          <div class="text-sm text-light"><%= t('analytics.unique_viewers') %></div>
        </div>
      </div>
      <div class="card">
        <div class="card-body text-center">
          <div style="font-size: 2rem; font-weight: 800; color: var(--red-500);"><%= stats.favoriteCount %></div>
          <div class="text-sm text-light"><%= t('analytics.favorites') %></div>
        </div>
      </div>
      <div class="card">
        <div class="card-body text-center">
          <div style="font-size: 2rem; font-weight: 800; color: var(--amber-600);"><%= stats.offerCount %></div>
          <div class="text-sm text-light"><%= t('analytics.offers') %></div>
        </div>
      </div>
    </div>

    <!-- Daily Views Chart -->
    <div class="card mb-2">
      <div class="card-body" style="padding: 1.5rem;">
        <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;"><%= t('analytics.daily_views') %></h2>
        <canvas id="viewsChart" style="width: 100%; max-height: 300px;"></canvas>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function() {
  var dailyData = <%- JSON.stringify(dailyData) %>;
  var labels = dailyData.map(function(d) { return d.label; });
  var data = dailyData.map(function(d) { return d.views; });

  var ctx = document.getElementById('viewsChart').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: '<%= t("analytics.views") %>',
        data: data,
        backgroundColor: 'rgba(13, 148, 136, 0.6)',
        borderColor: 'rgba(13, 148, 136, 1)',
        borderWidth: 1,
        borderRadius: 4,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: { stepSize: 1, precision: 0 },
          grid: { color: 'rgba(0,0,0,0.05)' },
        },
        x: {
          grid: { display: false },
          ticks: {
            maxTicksLimit: 10,
            font: { size: 11 },
          },
        }
      }
    }
  });
})();
</script>

<%- include('../partials/footer') %>
