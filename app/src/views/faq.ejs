<%- include('partials/header', { pageTitle: t('faq.title'), user }) %>

<style>
  .faq-section { margin-bottom: 1.5rem; }
  .faq-section > summary {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gray-900);
    cursor: pointer;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all var(--transition);
    user-select: none;
  }
  .faq-section > summary:hover { border-color: var(--primary); color: var(--primary); }
  .faq-section[open] > summary {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-color: var(--primary);
    color: var(--primary);
    background: var(--teal-50);
  }
  .faq-section > summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--gray-100);
    color: var(--gray-600);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
    transition: all var(--transition);
  }
  .faq-section[open] > summary::before {
    content: '-';
    background: var(--primary);
    color: var(--white);
  }
  .faq-section > summary::-webkit-details-marker { display: none; }
  .faq-content {
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: none;
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    line-height: 1.7;
    color: var(--gray-700);
    font-size: 0.9375rem;
  }
  .faq-content h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--gray-800);
    margin: 1.25rem 0 0.5rem 0;
  }
  .faq-content h3:first-child { margin-top: 0; }
  .faq-content p { margin-bottom: 0.75rem; }
  .faq-content ul, .faq-content ol {
    margin: 0.5rem 0 1rem 1.5rem;
    list-style: disc;
  }
  .faq-content ol { list-style: decimal; }
  .faq-content li { margin-bottom: 0.35rem; }
  .faq-content .highlight {
    background: var(--amber-50);
    border: 1px solid var(--amber-200);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0.75rem 0;
    font-weight: 500;
  }
  .faq-content .info-box {
    background: var(--teal-50);
    border: 1px solid var(--teal-200);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0.75rem 0;
  }
  .commission-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9rem;
  }
  .commission-table th, .commission-table td {
    padding: 0.75rem 1rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .commission-table th {
    background: var(--gray-50);
    font-weight: 700;
    color: var(--text-dark);
    font-size: 0.85rem;
  }
  .commission-table td:first-child { text-align: left; font-weight: 600; }
  .commission-table tr:last-child td { border-bottom: none; }
</style>

<section class="py-3">
  <div class="container" style="max-width: 860px;">
    <div class="text-center mb-3">
      <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;"><%= t('faq.title') %></h1>
      <p class="text-light" style="font-size: 1.05rem;"><%= t('faq.subtitle') %></p>
    </div>

    <!-- 1. How SwapMart Works -->
    <details class="faq-section" open>
      <summary><%= t('faq.how_it_works') %></summary>
      <div class="faq-content">
        <p>SwapMart is Switzerland's community-driven marketplace where you can <strong>buy, sell, and swap</strong> items with other users. Unlike traditional marketplaces, SwapMart was built around the idea that trading should be fair, transparent, and accessible to everyone.</p>
        <p>Our platform supports three types of transactions:</p>
        <ul>
          <li><strong>Cash offers</strong> -- buy an item with CHF</li>
          <li><strong>Swap offers</strong> -- trade one of your items for another (completely free!)</li>
          <li><strong>Swap + Cash offers</strong> -- combine an item swap with a cash top-up</li>
        </ul>
        <p>Every transaction is protected by our escrow system and buyer protection program, so both buyers and sellers can trade with confidence.</p>
      </div>
    </details>

    <!-- 2. Buying & Selling -->
    <details class="faq-section">
      <summary><%= t('faq.buying_selling') %></summary>
      <div class="faq-content">
        <h3>How to list an item</h3>
        <ol>
          <li>Click <strong>"Sell / Swap"</strong> in the navigation bar (you must be signed in).</li>
          <li>Upload 1 to 5 photos of your item. Clear, well-lit photos increase your chances of selling.</li>
          <li>Write a title and description. Be accurate and honest about the item's condition.</li>
          <li>Set your asking price in CHF and select whether you accept cash, swaps, or both.</li>
          <li>Choose a category and publish your listing.</li>
        </ol>

        <h3>How to make an offer</h3>
        <p>When you find something you want, click <strong>"Make an Offer"</strong> on the listing page. You can choose from:</p>
        <ul>
          <li><strong>Cash offer</strong> -- enter the amount in CHF you want to offer.</li>
          <li><strong>Swap offer</strong> -- select one of your own listings to offer as a trade.</li>
          <li><strong>Swap + Cash</strong> -- combine an item from your listings with a cash top-up.</li>
        </ul>

        <h3>How transactions complete</h3>
        <ol>
          <li>The seller reviews your offer and can accept, decline, or counter-offer.</li>
          <li>Once both parties agree, a chat is unlocked so you can coordinate details.</li>
          <li>The seller marks the transaction as completed once the exchange is done.</li>
          <li>A commission invoice is generated (if applicable) and both parties can leave reviews.</li>
        </ol>

        <h3>Shipping & meetup arrangements</h3>
        <p>SwapMart does not handle shipping directly. Buyers and sellers coordinate delivery through the built-in chat. Common options include:</p>
        <ul>
          <li>In-person meetup at a public location</li>
          <li>Swiss Post (Die Post / La Poste) shipping</li>
          <li>Any other method both parties agree on</li>
        </ul>
        <div class="info-box">We recommend meeting in well-lit, public places for in-person exchanges. Never share your home address with strangers.</div>
      </div>
    </details>

    <!-- 3. Fees & Commissions -->
    <details class="faq-section">
      <summary><%= t('faq.fees_commissions') %></summary>
      <div class="faq-content">
        <div class="highlight">Pure swaps (item for item with no cash component) are always <strong>100% FREE</strong> on every plan.</div>

        <h3>Commission tiers</h3>
        <p>Commissions are only charged on the <strong>cash component</strong> of a transaction. The rate depends on the transaction amount and your plan:</p>

        <table class="commission-table">
          <thead>
            <tr>
              <th style="text-align: left;">Transaction Amount (CHF)</th>
              <th>Free</th>
              <th style="color: var(--primary);">Seller Pro</th>
              <th style="color: var(--amber-600);">Business</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>0 - 50 CHF</td>
              <td>5%</td>
              <td style="color: var(--primary); font-weight: 600;">3%</td>
              <td style="color: var(--amber-600); font-weight: 600;">2%</td>
            </tr>
            <tr>
              <td>50 - 1,000 CHF</td>
              <td>8%</td>
              <td style="color: var(--primary); font-weight: 600;">6%</td>
              <td style="color: var(--amber-600); font-weight: 600;">4%</td>
            </tr>
            <tr>
              <td>1,000 - 10,000 CHF</td>
              <td>6%</td>
              <td style="color: var(--primary); font-weight: 600;">4%</td>
              <td style="color: var(--amber-600); font-weight: 600;">3%</td>
            </tr>
            <tr>
              <td>10,000+ CHF</td>
              <td>4%</td>
              <td style="color: var(--primary); font-weight: 600;">3%</td>
              <td style="color: var(--amber-600); font-weight: 600;">2%</td>
            </tr>
          </tbody>
        </table>

        <h3>When fees are charged</h3>
        <p>Fees apply <strong>only to the cash component</strong> of a transaction. For example, if you sell a CHF 500 item and receive CHF 200 cash + a swap item, the commission is calculated on CHF 200 only.</p>

        <h3>Invoicing process</h3>
        <p>After a transaction is marked as completed, an invoice is automatically generated and visible in your <strong>Invoices</strong> dashboard. Invoices are due within 30 days. All amounts are in CHF.</p>
      </div>
    </details>

    <!-- 4. Buyer Protection -->
    <details class="faq-section">
      <summary><%= t('faq.buyer_protection') %></summary>
      <div class="faq-content">
        <h3>How escrow works</h3>
        <p>When a cash offer is accepted, the buyer's payment is held securely by SwapMart until the transaction is confirmed as complete by both parties. Funds are never released to the seller until the buyer confirms receipt of the item.</p>

        <h3>Dispute resolution process</h3>
        <ol>
          <li>Either party can open a dispute within 14 days of the transaction.</li>
          <li>Both parties submit evidence (photos, chat messages, tracking info).</li>
          <li>Our support team reviews the case and mediates a fair resolution within 48 hours.</li>
          <li>The final decision is communicated to both parties with a full explanation.</li>
        </ol>

        <h3>Money-back guarantee conditions</h3>
        <p>You are eligible for a full refund if:</p>
        <ul>
          <li>The item was <strong>not as described</strong> (significantly different from listing photos/description).</li>
          <li>The item <strong>never arrived</strong> and the seller cannot provide proof of shipping.</li>
          <li>The item is <strong>counterfeit</strong> when sold as genuine.</li>
        </ul>
        <div class="info-box">Buyer protection applies to transactions completed through the SwapMart platform. Off-platform deals are not covered.</div>
      </div>
    </details>

    <!-- 5. Seller Guidelines -->
    <details class="faq-section">
      <summary><%= t('faq.seller_guidelines') %></summary>
      <div class="faq-content">
        <h3>Photo requirements</h3>
        <ul>
          <li>Upload <strong>1 to 5 photos</strong> per listing.</li>
          <li>Photos must clearly show the item's condition, including any defects.</li>
          <li>Use natural lighting and avoid heavy filters.</li>
          <li>Do not use stock photos or images from the internet.</li>
        </ul>

        <h3>Prohibited content</h3>
        <ul>
          <li><strong>No phone numbers</strong> in listing descriptions or photos -- these are automatically blocked to prevent off-platform deals.</li>
          <li><strong>No profanity or offensive content</strong> in titles, descriptions, or photos.</li>
          <li><strong>No illegal items</strong> -- weapons, drugs, stolen goods, or anything prohibited under Swiss law.</li>
          <li><strong>No misleading descriptions</strong> -- describe the item accurately and honestly.</li>
        </ul>

        <h3>Accurate descriptions</h3>
        <p>Listings must accurately represent the item being sold. Misleading descriptions may result in disputes, negative reviews, and potential account suspension. Always disclose defects, damage, or missing parts.</p>
      </div>
    </details>

    <!-- 6. Account Rules -->
    <details class="faq-section">
      <summary><%= t('faq.account_rules') %></summary>
      <div class="faq-content">
        <h3>Eligibility</h3>
        <ul>
          <li>You must be <strong>18 years or older</strong> to create an account and participate in transactions.</li>
          <li><strong>One account per person</strong> -- operating multiple accounts is prohibited and will result in suspension of all accounts.</li>
        </ul>

        <h3>KYC requirements</h3>
        <p>For transactions involving items valued over <strong>CHF 5,000</strong>, identity verification (KYC) may be required. This protects both buyers and sellers and helps us comply with Swiss regulations.</p>

        <h3>What gets you banned</h3>
        <p>The following behaviors will result in account suspension or permanent ban:</p>
        <ul>
          <li>Fraud, scams, or intentionally deceiving other users.</li>
          <li>Selling counterfeit items as genuine.</li>
          <li>Harassment, threats, or abusive behavior towards other users.</li>
          <li>Repeatedly listing prohibited items.</li>
          <li>Operating multiple accounts.</li>
          <li>Circumventing fees by conducting transactions off-platform.</li>
          <li>Any violation of Swiss law.</li>
        </ul>
        <div class="highlight">First-time minor violations may result in a warning. Repeated or serious violations lead to immediate suspension.</div>
      </div>
    </details>

    <!-- 7. Swiss Regulations -->
    <details class="faq-section">
      <summary><%= t('faq.swiss_regulations') %></summary>
      <div class="faq-content">
        <h3>Governing law</h3>
        <p>SwapMart operates under <strong>Swiss law</strong>, specifically the Swiss Code of Obligations (OR/CO). All disputes are subject to the jurisdiction of the courts of Zurich, Switzerland.</p>

        <h3>Consumer protection</h3>
        <p>SwapMart complies with Swiss consumer protection standards (Konsumentenschutz). As a marketplace, we facilitate transactions between private individuals and ensure transparency in all fees and processes.</p>

        <h3>Data protection</h3>
        <p>We comply with the <strong>Swiss Federal Act on Data Protection (nDSG / revDSG)</strong>. Your personal data is processed only for the purposes of providing the marketplace service. We do not sell your data to third parties.</p>

        <h3>Currency</h3>
        <p>All transactions on SwapMart are conducted in <strong>Swiss Francs (CHF)</strong>.</p>

        <h3>Liability disclaimer (Haftungsausschluss)</h3>
        <p>SwapMart acts as an intermediary platform connecting buyers and sellers. The platform is <strong>not liable</strong> for the quality, safety, legality, or accuracy of items listed by users. Buyers are encouraged to inspect items carefully and use the buyer protection program for any issues.</p>
      </div>
    </details>

    <!-- 8. New User Limits -->
    <details class="faq-section">
      <summary><%= t('faq.new_user_limits') %></summary>
      <div class="faq-content">
        <p>To maintain a safe marketplace, new accounts have the following restrictions during the first 30 days:</p>
        <ul>
          <li><strong>Maximum 3 active listings</strong> at any time.</li>
          <li><strong>Verification required</strong> for items priced over CHF 5,000.</li>
        </ul>
        <p>These limits are lifted automatically as your account ages and you build reputation through successful transactions. Completed trades, positive reviews, and verified identity all contribute to your reputation score.</p>
        <div class="info-box">Tip: Complete your profile, verify your email, and make your first successful transaction to quickly build trust on the platform.</div>
      </div>
    </details>

    <!-- 9. Contact & Support -->
    <details class="faq-section">
      <summary><%= t('faq.contact_support') %></summary>
      <div class="faq-content">
        <p>Need help? Our support team is here for you.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem;">
          <div style="padding: 1rem; background: var(--gray-50); border-radius: var(--radius); text-align: center;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#9993;</div>
            <div style="font-weight: 700; margin-bottom: 0.25rem;">Email</div>
            <a href="mailto:support@swapmart.ch" style="font-weight: 600;">support@swapmart.ch</a>
          </div>
          <div style="padding: 1rem; background: var(--gray-50); border-radius: var(--radius); text-align: center;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#128339;</div>
            <div style="font-weight: 700; margin-bottom: 0.25rem;">Business Hours</div>
            <span class="text-light">Mon-Fri, 9:00-17:00 CET</span>
          </div>
          <div style="padding: 1rem; background: var(--gray-50); border-radius: var(--radius); text-align: center;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">&#127971;</div>
            <div style="font-weight: 700; margin-bottom: 0.25rem;">Company</div>
            <span class="text-light">Stuzzicadenti AG, Zurich, Switzerland</span>
          </div>
        </div>
      </div>
    </details>
  </div>
</section>

<%- include('partials/footer') %>
