<%- include('../partials/header', { pageTitle: 'Profile Settings', user }) %>

<section class="py-3">
  <div class="container" style="max-width: 600px;">
    <h1 style="font-size: 1.75rem; margin-bottom: 1.5rem;">Profile Settings</h1>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="card mb-2">
      <div class="card-body" style="padding: 1.5rem;">
        <h2 style="font-size: 1.1rem; margin-bottom: 1rem;">Account Information</h2>
        <div class="form-group">
          <label>Email</label>
          <input type="text" class="form-control" value="<%= profile.email %>" disabled
                 style="background: var(--bg); color: var(--text-light);">
        </div>
        <div class="form-group">
          <label>Username</label>
          <input type="text" class="form-control" value="<%= profile.username %>" disabled
                 style="background: var(--bg); color: var(--text-light);">
        </div>
        <div class="flex gap-1" style="flex-wrap: wrap;">
          <span class="badge badge-primary">Plan: <%= profile.plan %></span>
          <span class="badge badge-gray">KYC: <%= profile.kyc_status %></span>
          <span class="badge badge-gray">
            Joined: <%= new Date(profile.created_at).toLocaleDateString('en-CH') %>
          </span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body" style="padding: 1.5rem;">
        <h2 style="font-size: 1.1rem; margin-bottom: 1rem;">Edit Profile</h2>
        <form action="/profile/settings" method="POST">
          <div class="form-group">
            <label for="name">Display Name</label>
            <input type="text" id="name" name="name" class="form-control"
                   value="<%= profile.name || '' %>" placeholder="Your name">
          </div>

          <div class="form-group">
            <label for="bio">Bio</label>
            <textarea id="bio" name="bio" class="form-control" rows="3"
                      placeholder="Tell others about yourself..."><%= profile.bio || '' %></textarea>
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" class="form-control"
                   value="<%= profile.location || '' %>" placeholder="e.g. Zurich, CH">
          </div>

          <button type="submit" class="btn btn-primary btn-block">Save Changes</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
