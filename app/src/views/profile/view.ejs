<%- include('../partials/header', { pageTitle: profile.username, user }) %>

<section class="py-3">
  <div class="container">
    <!-- Profile Header -->
    <div class="card mb-2">
      <div class="card-body" style="padding: 2rem;">
        <div class="flex-center gap-2">
          <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 700; color: #fff; flex-shrink: 0;">
            <%= profile.username.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h1 style="font-size: 1.5rem; font-weight: 700;"><%= profile.name || profile.username %></h1>
            <div class="text-light">@<%= profile.username %></div>
            <div class="flex gap-1 mt-1" style="flex-wrap: wrap;">
              <span class="badge badge-primary">Rep: <%= profile.reputation_score %></span>
              <% if (profile.plan !== 'free') { %>
                <span class="badge badge-amber"><%= profile.plan.replace('_', ' ') %></span>
              <% } %>
              <% if (profile.kyc_status === 'verified') { %>
                <span class="badge badge-success">Verified</span>
              <% } %>
              <% if (profile.location) { %>
                <span class="badge badge-gray"><%= profile.location %></span>
              <% } %>
            </div>
            <% if (profile.bio) { %>
              <p class="mt-1 text-sm" style="max-width: 500px;"><%= profile.bio %></p>
            <% } %>
            <div class="text-sm text-light mt-1">
              Member since <%= new Date(profile.created_at).toLocaleDateString('en-CH', { year: 'numeric', month: 'long' }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Listings -->
    <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Active Listings (<%= listings.length %>)</h2>
    <% if (listings.length === 0) { %>
      <div class="card mb-3">
        <div class="card-body text-center py-3">
          <p class="text-light">No active listings.</p>
        </div>
      </div>
    <% } else { %>
      <div class="grid grid-4 mb-3">
        <% listings.forEach(listing => { %>
          <a href="/listings/<%= listing.slug || listing.id %>" class="card" style="text-decoration: none;">
            <% if (listing.image) { %>
              <img src="/uploads/<%= listing.image %>" alt="<%= listing.title %>" class="listing-img" loading="lazy">
            <% } else { %>
              <div class="listing-img-placeholder">&#128230;</div>
            <% } %>
            <div class="card-body">
              <h3 style="font-size: 0.9rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                <%= listing.title %>
              </h3>
              <% if (listing.price) { %>
                <span style="font-weight: 700; color: var(--primary); font-size: 0.9rem;">
                  CHF <%= parseFloat(listing.price).toLocaleString('de-CH') %>
                </span>
              <% } else { %>
                <span class="badge badge-amber">Swap</span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Reviews -->
    <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Reviews (<%= reviews.length %>)</h2>
    <% if (reviews.length === 0) { %>
      <div class="card">
        <div class="card-body text-center py-3">
          <p class="text-light">No reviews yet.</p>
        </div>
      </div>
    <% } else { %>
      <% reviews.forEach(review => { %>
        <div class="card mb-1">
          <div class="card-body">
            <div class="flex-between">
              <div>
                <strong><%= review.reviewer_name %></strong>
                <span class="text-light text-sm">
                  &middot; <%= new Date(review.created_at).toLocaleDateString('en-CH') %>
                </span>
              </div>
              <div style="color: var(--amber); letter-spacing: 2px;">
                <% for (let i = 0; i < 5; i++) { %>
                  <%= i < review.rating ? '&#9733;' : '&#9734;' %>
                <% } %>
              </div>
            </div>
            <% if (review.comment) { %>
              <p class="mt-1 text-sm"><%= review.comment %></p>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
