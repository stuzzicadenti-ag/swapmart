<%- include('../partials/header', { pageTitle: 'Browse Listings', user }) %>

<section class="py-3">
  <div class="container">
    <h1 class="section-heading mb-2">Browse Listings</h1>

    <button type="button" class="filter-toggle-btn" id="filterToggle" onclick="toggleFilters()">
      &#9776; Filters &amp; Sort
    </button>

    <div class="layout-sidebar">
      <!-- Sidebar Filters -->
      <aside id="filterSidebar">
        <form action="/listings" method="GET" class="card">
          <div class="card-body">
            <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem;">Filters</h3>

            <div class="form-group">
              <label for="q">Search</label>
              <input type="text" id="q" name="q" class="form-control" placeholder="Keywords..."
                     value="<%= filters.q || '' %>">
            </div>

            <div class="form-group">
              <label for="category">Category</label>
              <select id="category" name="category" class="form-control">
                <option value="">All Categories</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="type">Listing Type</label>
              <select id="type" name="type" class="form-control">
                <option value="">All Types</option>
                <option value="sell" <%= filters.type === 'sell' ? 'selected' : '' %>>For Sale</option>
                <option value="swap" <%= filters.type === 'swap' ? 'selected' : '' %>>For Swap</option>
                <option value="both" <%= filters.type === 'both' ? 'selected' : '' %>>Sell or Swap</option>
              </select>
            </div>

            <div class="form-group">
              <label for="mode">Listing Mode</label>
              <select id="mode" name="mode" class="form-control">
                <option value="">All Modes</option>
                <option value="fixed" <%= filters.mode === 'fixed' ? 'selected' : '' %>>Fixed Price</option>
                <option value="auction" <%= filters.mode === 'auction' ? 'selected' : '' %>>Auction</option>
              </select>
            </div>

            <div class="form-group">
              <label>Price Range (CHF)</label>
              <div class="flex gap-1">
                <input type="number" name="min_price" class="form-control" placeholder="Min"
                       value="<%= filters.min_price || '' %>" min="0" step="1">
                <input type="number" name="max_price" class="form-control" placeholder="Max"
                       value="<%= filters.max_price || '' %>" min="0" step="1">
              </div>
            </div>

            <div class="form-group">
              <label for="sort">Sort By</label>
              <select id="sort" name="sort" class="form-control">
                <option value="newest" <%= (filters.sort || 'newest') === 'newest' ? 'selected' : '' %>>Newest First</option>
                <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="ending_soon" <%= filters.sort === 'ending_soon' ? 'selected' : '' %>>Ending Soon</option>
              </select>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Apply Filters</button>
            <a href="/listings" class="btn btn-outline btn-block mt-1" style="text-align: center;">Clear</a>

            <% if (user) { %>
              <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border);">
                <button type="button" id="saveSearchBtn" class="btn btn-ghost btn-block btn--sm" style="color: var(--primary);" onclick="saveCurrentSearch()">
                  &#128278; <%= t('saved_searches.save_this_search') %>
                </button>
              </div>
            <% } %>
          </div>
        </form>
      </aside>

      <!-- Listings Grid -->
      <div>
        <div class="flex-between mb-2">
          <span class="text-light text-sm"><%= pagination.total %> listing<%= pagination.total !== 1 ? 's' : '' %> found</span>
          <% if (user) { %>
            <a href="/listings/new" class="btn btn-primary btn-sm">+ New Listing</a>
          <% } %>
        </div>

        <% if (listings.length === 0) { %>
          <div class="card">
            <div class="empty-state">
              <div class="empty-state__icon">&#128270;</div>
              <div class="empty-state__title">No listings match your filters</div>
              <div class="empty-state__text">Try broadening your search or <a href="/listings">view all listings</a>.</div>
            </div>
          </div>
        <% } else { %>
          <div class="grid grid-3">
            <% listings.forEach(listing => { %>
              <a href="/listings/<%= listing.slug || listing.id %>" class="listing-card-link">
                <div class="card card--interactive">
                  <div class="listing-img-wrap">
                    <% if (listing.image) { %>
                      <img src="/uploads/<%= listing.image %>" alt="<%= listing.title %>" class="listing-img" loading="lazy">
                    <% } else { %>
                      <div class="listing-img-placeholder">
                        <% const catIcons = { 'Trading Cards': '&#127183;', 'Electronics': '&#128187;', 'Cars & Vehicles': '&#128663;', 'Apartments & Housing': '&#127968;', 'Fashion': '&#128085;', 'Furniture': '&#128715;', 'Sports': '&#127942;', 'Collectibles': '&#128142;' }; %>
                        <%- catIcons[listing.category_name] || '&#128230;' %>
                      </div>
                    <% } %>
                    <!-- Overlay badges -->
                    <div style="position: absolute; top: 8px; left: 8px; display: flex; gap: 4px;">
                      <% if (listing.listing_mode === 'auction') { %>
                        <span class="badge badge-auction">Auction</span>
                      <% } %>
                    </div>
                    <% if (listing.type === 'swap') { %>
                      <div style="position: absolute; top: 8px; right: 8px;">
                        <span class="badge badge-amber">Swap</span>
                      </div>
                    <% } else if (listing.type === 'both') { %>
                      <div style="position: absolute; top: 8px; right: 8px;">
                        <span class="badge badge-amber">Sell / Swap</span>
                      </div>
                    <% } %>
                  </div>
                  <div class="card-body">
                    <span class="badge badge-primary mb-1" style="align-self: flex-start;"><%= listing.category_name %></span>
                    <h3 class="listing-card__title"><%= listing.title %></h3>

                    <div class="card-body__bottom">
                      <% if (listing.listing_mode === 'auction') { %>
                        <div class="flex-between">
                          <div>
                            <% if (listing.current_bid) { %>
                              <span class="price-tag--sm">
                                CHF <%= parseFloat(listing.current_bid).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                              </span>
                            <% } else { %>
                              <span style="font-weight: 600; color: var(--text-light); font-size: 0.85rem;">
                                From CHF <%= parseFloat(listing.starting_price).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                              </span>
                            <% } %>
                          </div>
                          <span class="text-xs text-light"><%= listing.bid_count || 0 %> bid<%= listing.bid_count != 1 ? 's' : '' %></span>
                        </div>
                        <% if (listing.auction_end) { %>
                          <div class="auction-countdown mt-1" data-end="<%= new Date(listing.auction_end).toISOString() %>">
                            ...
                          </div>
                        <% } %>
                      <% } else { %>
                        <div class="flex-between">
                          <% if (listing.price) { %>
                            <span class="price-tag--sm">
                              CHF <%= parseFloat(listing.price).toLocaleString('de-CH', { minimumFractionDigits: 0 }) %>
                            </span>
                          <% } else { %>
                            <span class="badge badge-amber">Swap Only</span>
                          <% } %>
                          <span class="text-xs text-light"><%= listing.seller_name %></span>
                        </div>
                      <% } %>

                      <% if (listing.condition) { %>
                        <div class="mt-1">
                          <span class="badge badge-gray"><%= listing.condition.replace('_', ' ') %></span>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>

          <!-- Pagination -->
          <% if (pagination.totalPages > 1) { %>
            <div class="pagination">
              <% if (pagination.page > 1) { %>
                <a href="/listings?page=<%= pagination.page - 1 %>&<%= new URLSearchParams(Object.fromEntries(Object.entries(filters).filter(([,v]) => v))).toString() %>">Prev</a>
              <% } %>
              <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                <% if (i === pagination.page) { %>
                  <span class="active"><%= i %></span>
                <% } else { %>
                  <a href="/listings?page=<%= i %>&<%= new URLSearchParams(Object.fromEntries(Object.entries(filters).filter(([,v]) => v))).toString() %>"><%= i %></a>
                <% } %>
              <% } %>
              <% if (pagination.page < pagination.totalPages) { %>
                <a href="/listings?page=<%= pagination.page + 1 %>&<%= new URLSearchParams(Object.fromEntries(Object.entries(filters).filter(([,v]) => v))).toString() %>">Next</a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
// Mobile filter toggle
function toggleFilters() {
  var sidebar = document.getElementById('filterSidebar');
  sidebar.classList.toggle('filter-open');
  document.body.style.overflow = sidebar.classList.contains('filter-open') ? 'hidden' : '';
}
// Close filter drawer on form submit
(function() {
  var form = document.querySelector('#filterSidebar form');
  if (form) {
    form.addEventListener('submit', function() {
      var sidebar = document.getElementById('filterSidebar');
      if (sidebar) sidebar.classList.remove('filter-open');
      document.body.style.overflow = '';
    });
  }
})();
</script>

<script>
// Mini countdown for auction cards in listing grid
(function() {
  var countdowns = document.querySelectorAll('.auction-countdown[data-end]');
  function tick() {
    countdowns.forEach(function(el) {
      var end = new Date(el.getAttribute('data-end')).getTime();
      var diff = end - Date.now();
      if (diff <= 0) {
        el.textContent = 'Ended';
        el.classList.add('ending-soon');
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      var txt = '';
      if (d > 0) txt += d + 'd ';
      txt += h + 'h ' + m + 'm';
      if (d === 0) txt += ' ' + s + 's';
      el.textContent = txt;
      if (diff < 3600000) el.classList.add('ending-soon');
    });
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

<script>
function saveCurrentSearch() {
  var btn = document.getElementById('saveSearchBtn');
  var name = prompt('<%= t("saved_searches.name_prompt") %>');
  if (name === null) return;
  if (!name) name = 'Search';

  var data = new URLSearchParams();
  data.append('name', name);
  <% if (filters.q) { %>data.append('query', '<%= filters.q %>');<% } %>
  <% if (filters.category) { %>data.append('category', '<%= filters.category %>');<% } %>
  <% if (filters.type) { %>data.append('type', '<%= filters.type %>');<% } %>
  <% if (filters.mode) { %>data.append('mode', '<%= filters.mode %>');<% } %>
  <% if (filters.min_price) { %>data.append('min_price', '<%= filters.min_price %>');<% } %>
  <% if (filters.max_price) { %>data.append('max_price', '<%= filters.max_price %>');<% } %>

  fetch('/search/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
    body: data.toString()
  })
  .then(function(r) { return r.json(); })
  .then(function(result) {
    if (result.error) {
      btn.textContent = result.error;
      btn.style.color = 'var(--red-500)';
    } else {
      btn.innerHTML = '&#10003; <%= t("saved_searches.saved") %>';
      btn.style.color = 'var(--green-500)';
      btn.disabled = true;
    }
    setTimeout(function() {
      btn.innerHTML = '&#128278; <%= t("saved_searches.save_this_search") %>';
      btn.style.color = 'var(--primary)';
      btn.disabled = false;
    }, 3000);
  })
  .catch(function() {
    btn.textContent = 'Error';
    btn.style.color = 'var(--red-500)';
  });
}
</script>

<%- include('../partials/footer') %>
