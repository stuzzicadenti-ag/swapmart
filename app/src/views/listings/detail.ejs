<%- include('../partials/header', { pageTitle: listing.title, user }) %>

<section class="py-3">
  <div class="container">
    <a href="/listings" class="text-sm text-light" style="display: inline-block; margin-bottom: 1rem;">&larr; Back to listings</a>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (typeof kycVerified !== 'undefined' && !kycVerified && user) { %>
      <div class="kyc-banner">
        <span class="kyc-banner__icon">&#9888;</span>
        <div>
          Complete <a href="/profile/verify">identity verification</a> to unlock messaging, bidding, and offers above CHF 50.
        </div>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem;">
      <!-- Left: Images -->
      <div>
        <% if (images.length > 0) { %>
          <div class="card mb-2" style="cursor: zoom-in; border-radius: var(--radius-lg);" id="mainImageWrap" onclick="openGallery(currentImageIndex)">
            <img src="/uploads/<%= images[0].file_path %>" alt="<%= listing.title %>"
                 style="width: 100%; max-height: 500px; object-fit: contain; background: #f8fafc;" id="mainImage">
          </div>
          <% if (images.length > 1) { %>
            <div style="overflow-x: auto; white-space: nowrap; padding-bottom: 4px;" id="thumbStrip">
              <% images.forEach((img, i) => { %>
                <img src="/uploads/<%= img.file_path %>" alt="Image <%= i + 1 %>"
                     style="width: 80px; height: 60px; object-fit: cover; border-radius: var(--radius); cursor: pointer; border: 2px solid <%= i === 0 ? 'var(--primary)' : 'var(--border)' %>; display: inline-block; margin-right: 6px; vertical-align: top; transition: border-color 0.15s;"
                     onclick="selectThumb(<%= i %>)"
                     data-thumb="<%= i %>">
              <% }) %>
            </div>
          <% } %>
        <% } else { %>
          <div class="card" style="border-radius: var(--radius-lg);">
            <div class="listing-img-placeholder" style="aspect-ratio: 4/3; font-size: 4rem;">
              <% const catIcons = { 'Trading Cards': '&#127183;', 'Electronics': '&#128187;', 'Cars & Vehicles': '&#128663;', 'Apartments & Housing': '&#127968;', 'Fashion': '&#128085;', 'Furniture': '&#128715;', 'Sports': '&#127942;', 'Collectibles': '&#128142;' }; %>
              <%- catIcons[listing.category_name] || '&#128230;' %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Right: Details -->
      <div>
        <div class="card mb-2">
          <div class="card-body" style="padding: 1.5rem;">
            <div class="flex gap-1 mb-1" style="flex-wrap: wrap;">
              <span class="badge badge-primary"><%= listing.category_name %></span>
              <span class="badge badge-gray"><%= listing.condition.replace('_', ' ') %></span>
              <% if (listing.listing_mode === 'auction') { %>
                <span class="badge badge-auction">Auction</span>
              <% } %>
              <% if (listing.type === 'swap') { %>
                <span class="badge badge-amber">Swap Only</span>
              <% } else if (listing.type === 'both') { %>
                <span class="badge badge-amber">Sell / Swap</span>
              <% } %>
              <% if (listing.status !== 'active') { %>
                <span class="badge badge-danger"><%= listing.status %></span>
              <% } %>
            </div>

            <div class="flex-between" style="align-items: flex-start;">
              <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; letter-spacing: -0.01em; flex: 1;"><%= listing.title %></h1>
              <% if (user) { %>
                <button type="button" id="favBtn" onclick="toggleFavorite(<%= listing.id %>)"
                        title="<%= typeof isFavorited !== 'undefined' && isFavorited ? t('favorites.remove') : t('favorites.add') %>"
                        style="background: none; border: none; cursor: pointer; font-size: 1.5rem; padding: 4px 8px; flex-shrink: 0; transition: transform 0.15s;">
                  <% if (typeof isFavorited !== 'undefined' && isFavorited) { %>&#10084;&#65039;<% } else { %>&#9825;<% } %>
                </button>
              <% } %>
            </div>
            <% if (typeof favoriteCount !== 'undefined' && favoriteCount > 0) { %>
              <div class="text-xs text-light" style="margin-top: -0.5rem; margin-bottom: 0.5rem;">
                <span id="favCount"><%= favoriteCount %></span> <%= t('favorites.people_favorited') %>
              </div>
            <% } %>

            <% if (listing.listing_mode === 'auction') { %>
              <!-- Auction info -->
              <div style="background: linear-gradient(135deg, var(--amber-50), var(--amber-100)); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                  <div>
                    <div class="text-xs text-light" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Current Bid</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary);">
                      <% if (bids && bids.length > 0) { %>
                        CHF <%= parseFloat(bids[0].amount).toLocaleString('de-CH', { minimumFractionDigits: 2 }) %>
                      <% } else { %>
                        CHF <%= parseFloat(listing.starting_price).toLocaleString('de-CH', { minimumFractionDigits: 2 }) %>
                        <span class="text-xs text-light" style="font-weight: 400;">(starting)</span>
                      <% } %>
                    </div>
                  </div>
                  <div>
                    <div class="text-xs text-light" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Bids</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--text);">
                      <%= bids ? bids.length : 0 %>
                    </div>
                  </div>
                </div>

                <% if (listing.auction_end && listing.status === 'active') { %>
                  <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--amber-200);">
                    <div class="text-xs text-light" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Time Remaining</div>
                    <div id="auctionCountdown" class="auction-countdown" style="font-size: 1.1rem;"
                         data-end="<%= new Date(listing.auction_end).toISOString() %>">
                      Loading...
                    </div>
                  </div>
                <% } %>

                <% if (listing.buy_now_price) { %>
                  <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--amber-200);">
                    <div class="text-xs text-light" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Buy Now Price</div>
                    <div style="font-size: 1.25rem; font-weight: 700; color: var(--amber-700);">
                      CHF <%= parseFloat(listing.buy_now_price).toLocaleString('de-CH', { minimumFractionDigits: 2 }) %>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } else { %>
              <% if (listing.price) { %>
                <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary); margin-bottom: 1rem;">
                  CHF <%= parseFloat(listing.price).toLocaleString('de-CH', { minimumFractionDigits: 2 }) %>
                </div>
              <% } %>
            <% } %>

            <% if (listing.location) { %>
              <p class="text-light text-sm mb-1">Location: <strong><%= listing.location %></strong></p>
            <% } %>

            <p class="text-sm text-light mb-2">
              Listed <%= new Date(listing.created_at).toLocaleDateString('en-CH', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>

            <% if (listing.description) { %>
              <div style="border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1rem;">
                <h3 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">Description</h3>
                <p style="white-space: pre-line; color: var(--text); font-size: 0.9375rem;"><%= listing.description %></p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Seller info -->
        <div class="card mb-2">
          <div class="card-body">
            <h3 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.04em;">Seller</h3>
            <div class="flex-center gap-1">
              <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--teal-200), var(--teal-400)); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--white); font-size: 1rem;">
                <%= listing.seller_name.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div class="flex-center gap-1">
                  <a href="/profile/<%= listing.seller_user_id %>" style="font-weight: 600;"><%= listing.seller_name %></a>
                  <% if (typeof sellerRating !== 'undefined' && sellerRating.trustBadge === 'gold') { %>
                    <span class="badge" style="background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #78350f; font-weight: 700; font-size: 0.65rem;">&#127942; Gold</span>
                  <% } else if (typeof sellerRating !== 'undefined' && sellerRating.trustBadge === 'silver') { %>
                    <span class="badge" style="background: linear-gradient(135deg, #e5e7eb, #d1d5db); color: #374151; font-weight: 700; font-size: 0.65rem;">&#129351; Silver</span>
                  <% } else if (typeof sellerRating !== 'undefined' && sellerRating.trustBadge === 'bronze') { %>
                    <span class="badge" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; font-weight: 700; font-size: 0.65rem;">&#129352; Bronze</span>
                  <% } %>
                </div>
                <div class="text-sm text-light">
                  <% if (typeof sellerRating !== 'undefined' && sellerRating.count > 0) { %>
                    <span style="color: var(--amber-500);">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= Math.round(sellerRating.avg)) { %>&#9733;<% } else { %>&#9734;<% } %>
                      <% } %>
                    </span>
                    <span><%= sellerRating.avg.toFixed(1) %></span>
                    <a href="/seller/<%= listing.seller_user_id %>/reviews" style="color: var(--text-light);">(<%= sellerRating.count %> reviews)</a>
                  <% } else { %>
                    Rep: <%= listing.reputation_score %>
                  <% } %>
                  <% if (listing.seller_location) { %> &middot; <%= listing.seller_location %><% } %>
                </div>
              </div>
            </div>
            <% if (user && user.id === listing.seller_user_id) { %>
              <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border);">
                <a href="/analytics/listings/<%= listing.id %>" class="btn btn--outline btn--sm" style="width: 100%; text-align: center;">
                  &#128202; <%= t('analytics.view_analytics') %>
                </a>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Report Button -->
        <% if (user && user.id !== listing.seller_user_id) { %>
          <div style="margin-bottom: 1rem; text-align: right;">
            <form action="/listings/<%= listing.id %>/report" method="POST" style="display: inline;"
                  onsubmit="var r = prompt('Why are you reporting this listing?'); if (!r) return false; this.querySelector('[name=reason]').value = r;">
              <input type="hidden" name="reason" value="">
              <button type="submit" class="btn btn-ghost btn--sm" style="color: var(--text-light); font-size: 0.8rem;">
                &#9873; Report
              </button>
            </form>
          </div>
        <% } %>

        <% if (listing.listing_mode === 'auction' && listing.status === 'active' && user && user.id !== listing.seller_user_id) { %>
          <!-- Place a Bid -->
          <div class="card mb-2">
            <div class="card-body" style="padding: 1.5rem;">
              <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Place a Bid</h3>
              <% if (typeof kycVerified !== 'undefined' && !kycVerified) { %>
                <div class="alert alert-warning" style="margin-bottom: 0;">
                  <a href="/profile/verify">Complete identity verification</a> to place bids in auctions.
                </div>
              <% } else { %>
                <form action="/listings/<%= listing.id %>/bid" method="POST">
                  <div class="form-group">
                    <label for="bid_amount">Your Bid (CHF)</label>
                    <%
                      var minBid = (bids && bids.length > 0)
                        ? (parseFloat(bids[0].amount) + parseFloat(listing.min_bid_increment)).toFixed(2)
                        : parseFloat(listing.starting_price).toFixed(2);
                    %>
                    <input type="number" id="bid_amount" name="bid_amount" class="form-control"
                           step="0.01" min="<%= minBid %>" value="<%= minBid %>" required>
                    <p class="text-xs text-light mt-1">
                      Minimum bid: CHF <%= minBid %>
                      (increment: CHF <%= parseFloat(listing.min_bid_increment).toFixed(2) %>)
                    </p>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block">Place Bid</button>
                </form>
              <% } %>
            </div>
          </div>

          <!-- Buy Now -->
          <% if (listing.buy_now_price) { %>
            <div class="card mb-2">
              <div class="card-body" style="padding: 1.25rem;">
                <div class="flex-between" style="flex-wrap: wrap; gap: 0.5rem;">
                  <div>
                    <div class="text-sm font-bold">Buy Now</div>
                    <div style="font-size: 1.25rem; font-weight: 700; color: var(--amber-700);">
                      CHF <%= parseFloat(listing.buy_now_price).toLocaleString('de-CH', { minimumFractionDigits: 2 }) %>
                    </div>
                  </div>
                  <% if (typeof kycVerified !== 'undefined' && kycVerified) { %>
                    <form action="/listings/<%= listing.id %>/buy-now" method="POST">
                      <button type="submit" class="btn btn--accent" onclick="return confirm('Buy this item now for CHF <%= parseFloat(listing.buy_now_price).toFixed(2) %>?')">Buy Now</button>
                    </form>
                  <% } else { %>
                    <a href="/profile/verify" class="btn btn--outline btn--sm">Verify to Buy Now</a>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>

          <!-- Bid History -->
          <% if (bids && bids.length > 0) { %>
            <div class="card mb-2">
              <div class="card-body" style="padding: 1.25rem;">
                <h3 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.75rem;">Bid History (<%= bids.length %>)</h3>
                <div style="max-height: 200px; overflow-y: auto;">
                  <% bids.forEach((bid, i) => { %>
                    <div class="flex-between" style="padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.8125rem;">
                      <div class="flex-center gap-1">
                        <% if (i === 0) { %><span class="badge badge-success" style="font-size: 0.7rem;">Highest</span><% } %>
                        <span style="font-weight: <%= i === 0 ? '700' : '400' %>;"><%= bid.bidder_name %></span>
                      </div>
                      <div class="flex-center gap-2">
                        <span style="font-weight: 700; color: var(--primary);">CHF <%= parseFloat(bid.amount).toFixed(2) %></span>
                        <span class="text-light text-xs">
                          <%= new Date(bid.created_at).toLocaleString('en-CH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        </span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% } %>

        <% } else if (listing.listing_mode === 'auction' && listing.status !== 'active') { %>
          <!-- Auction ended info -->
          <div class="card mb-2">
            <div class="card-body text-center" style="padding: 1.5rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">&#128276;</div>
              <% if (listing.status === 'sold') { %>
                <p style="font-weight: 600;">This auction has ended</p>
                <% if (listing._auction_winner) { %>
                  <p class="text-sm text-light">
                    Won by <strong><%= listing._auction_winner.bidder_name %></strong>
                    for CHF <%= parseFloat(listing._auction_winner.amount).toFixed(2) %>
                  </p>
                <% } %>
              <% } else if (listing.status === 'expired') { %>
                <p style="font-weight: 600;">This auction expired with no bids</p>
              <% } %>
            </div>
          </div>

          <!-- Bid History for ended auctions -->
          <% if (bids && bids.length > 0) { %>
            <div class="card mb-2">
              <div class="card-body" style="padding: 1.25rem;">
                <h3 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.75rem;">Bid History (<%= bids.length %>)</h3>
                <% bids.forEach((bid, i) => { %>
                  <div class="flex-between" style="padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.8125rem;">
                    <span><%= bid.bidder_name %></span>
                    <span style="font-weight: 600;">CHF <%= parseFloat(bid.amount).toFixed(2) %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

        <% } else if (listing.listing_mode !== 'auction') { %>
          <!-- Make an Offer (fixed price mode) -->
          <% if (user && user.id !== listing.seller_user_id && listing.status === 'active') { %>
            <div class="card">
              <div class="card-body" style="padding: 1.5rem;">
                <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Make an Offer</h3>
                <form action="/listings/<%= listing.id %>/offer" method="POST">
                  <div class="form-group">
                    <label for="offer_type">Offer Type</label>
                    <select id="offer_type" name="offer_type" class="form-control" onchange="toggleOfferFields()">
                      <% if (listing.type !== 'swap') { %>
                        <option value="cash">Cash Offer</option>
                      <% } %>
                      <% if (listing.type !== 'sell') { %>
                        <option value="swap">Swap</option>
                      <% } %>
                      <option value="swap_cash">Swap + Cash</option>
                    </select>
                  </div>

                  <div class="form-group" id="cashField">
                    <label for="cash_amount">Cash Amount (CHF)</label>
                    <input type="number" id="cash_amount" name="cash_amount" class="form-control"
                           step="0.01" min="0" placeholder="0.00"
                           value="<%= listing.price || '' %>">
                  </div>

                  <div class="form-group" id="swapField" style="display: none;">
                    <label for="swap_listing_id">Your Item to Swap</label>
                    <select id="swap_listing_id" name="swap_listing_id" class="form-control">
                      <option value="">Select one of your listings...</option>
                      <% userListings.forEach(ul => { %>
                        <option value="<%= ul.id %>"><%= ul.title %></option>
                      <% }) %>
                    </select>
                    <% if (userListings.length === 0) { %>
                      <p class="text-sm text-light mt-1">You have no active listings to swap. <a href="/listings/new">Create one first</a>.</p>
                    <% } %>
                  </div>

                  <div class="form-group">
                    <label for="message">Message (optional)</label>
                    <textarea id="message" name="message" class="form-control" rows="3" placeholder="Add a message to the seller..."></textarea>
                  </div>

                  <button type="submit" class="btn btn-primary btn-block">Send Offer</button>
                </form>
              </div>
            </div>

            <script>
              function toggleOfferFields() {
                var type = document.getElementById('offer_type').value;
                document.getElementById('cashField').style.display = (type === 'swap') ? 'none' : 'block';
                document.getElementById('swapField').style.display = (type === 'cash') ? 'none' : 'block';
              }
              toggleOfferFields();
            </script>
          <% } else if (!user) { %>
            <div class="card">
              <div class="card-body text-center" style="padding: 1.5rem;">
                <p class="mb-1">Interested in this item?</p>
                <a href="/auth/login" class="btn btn-primary">Login to Make an Offer</a>
              </div>
            </div>
          <% } %>
        <% } %>

        <% if (!user && listing.listing_mode === 'auction') { %>
          <div class="card">
            <div class="card-body text-center" style="padding: 1.5rem;">
              <p class="mb-1">Want to bid on this auction?</p>
              <a href="/auth/login" class="btn btn-primary">Login to Place a Bid</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Similar Listings -->
    <% if (similar.length > 0) { %>
      <div class="mt-3">
        <h2 class="section-heading--sm" style="margin-bottom: 1rem;">Similar Listings</h2>
        <div class="grid grid-4">
          <% similar.forEach(s => { %>
            <a href="/listings/<%= s.slug || s.id %>" class="card" style="text-decoration: none;">
              <% if (s.image) { %>
                <img src="/uploads/<%= s.image %>" alt="<%= s.title %>" class="listing-img" loading="lazy">
              <% } else { %>
                <div class="listing-img-placeholder">&#128230;</div>
              <% } %>
              <div class="card-body">
                <h3 style="font-size: 0.9rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= s.title %>
                </h3>
                <div class="flex-between mt-1">
                  <% if (s.price) { %>
                    <span style="font-weight: 700; color: var(--primary); font-size: 0.9rem;">
                      CHF <%= parseFloat(s.price).toLocaleString('de-CH') %>
                    </span>
                  <% } else { %>
                    <span class="badge badge-amber">Swap</span>
                  <% } %>
                  <span class="text-sm text-light"><%= s.seller_name %></span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<!-- Fullscreen Gallery Overlay -->
<% if (images.length > 0) { %>
<div id="galleryOverlay" style="
  display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.92); z-index: 9999; align-items: center; justify-content: center;
  flex-direction: column;
">
  <button type="button" onclick="closeGallery()" style="
    position: absolute; top: 16px; right: 20px; background: none; border: none;
    color: #fff; font-size: 2rem; cursor: pointer; z-index: 10001; padding: 8px;
    line-height: 1;
  " aria-label="Close gallery">&times;</button>

  <% if (images.length > 1) { %>
    <button type="button" onclick="galleryNav(-1)" style="
      position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
      background: rgba(255,255,255,0.15); border: none; color: #fff; font-size: 2rem;
      width: 48px; height: 48px; border-radius: 50%; cursor: pointer; z-index: 10001;
      display: flex; align-items: center; justify-content: center;
    " aria-label="Previous image">&#10094;</button>

    <button type="button" onclick="galleryNav(1)" style="
      position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
      background: rgba(255,255,255,0.15); border: none; color: #fff; font-size: 2rem;
      width: 48px; height: 48px; border-radius: 50%; cursor: pointer; z-index: 10001;
      display: flex; align-items: center; justify-content: center;
    " aria-label="Next image">&#10095;</button>
  <% } %>

  <img id="galleryImage" src="" alt="" style="
    max-width: 90vw; max-height: 80vh; object-fit: contain; border-radius: 4px;
  ">

  <div id="galleryCounter" style="
    color: rgba(255,255,255,0.7); margin-top: 12px; font-size: 0.875rem;
  "></div>
</div>
<% } %>

<style>
  @media (max-width: 768px) {
    section .container > div:first-of-type { grid-template-columns: 1fr !important; }
  }
  #galleryOverlay button:hover {
    background: rgba(255,255,255,0.25) !important;
  }
</style>

<script>
(function() {
  var galleryImages = [<% images.forEach((img, i) => { %>'<%= img.file_path %>'<% if (i < images.length - 1) { %>,<% } %><% }) %>];
  var currentIndex = 0;
  window.currentImageIndex = 0;

  window.selectThumb = function(idx) {
    currentIndex = idx;
    window.currentImageIndex = idx;
    var mainImg = document.getElementById('mainImage');
    mainImg.src = '/uploads/' + galleryImages[idx];
    var thumbs = document.querySelectorAll('[data-thumb]');
    thumbs.forEach(function(t) { t.style.borderColor = 'var(--border)'; });
    if (thumbs[idx]) thumbs[idx].style.borderColor = 'var(--primary)';
  };

  window.openGallery = function(startIdx) {
    if (galleryImages.length === 0) return;
    currentIndex = startIdx || 0;
    document.getElementById('galleryOverlay').style.display = 'flex';
    updateGalleryImage();
    document.body.style.overflow = 'hidden';
  };

  window.closeGallery = function() {
    document.getElementById('galleryOverlay').style.display = 'none';
    document.body.style.overflow = '';
  };

  window.galleryNav = function(dir) {
    currentIndex = (currentIndex + dir + galleryImages.length) % galleryImages.length;
    updateGalleryImage();
  };

  function updateGalleryImage() {
    document.getElementById('galleryImage').src = '/uploads/' + galleryImages[currentIndex];
    var counter = document.getElementById('galleryCounter');
    if (counter) counter.textContent = (currentIndex + 1) + ' / ' + galleryImages.length;
  }

  document.addEventListener('keydown', function(e) {
    var overlay = document.getElementById('galleryOverlay');
    if (!overlay || overlay.style.display === 'none') return;
    if (e.key === 'Escape') closeGallery();
    if (e.key === 'ArrowLeft') galleryNav(-1);
    if (e.key === 'ArrowRight') galleryNav(1);
  });

  var overlay = document.getElementById('galleryOverlay');
  if (overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeGallery();
    });
  }

  // Favorite toggle
  window.toggleFavorite = function(listingId) {
    var btn = document.getElementById('favBtn');
    fetch('/favorites/' + listingId + '/toggle', { method: 'POST', headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        btn.innerHTML = data.favorited ? '&#10084;&#65039;' : '&#9825;';
        btn.style.transform = 'scale(1.3)';
        setTimeout(function() { btn.style.transform = 'scale(1)'; }, 200);
        var countEl = document.getElementById('favCount');
        if (countEl) countEl.textContent = data.count;
      })
      .catch(function() { /* ignore */ });
  };

  // Auction countdown timer
  var countdownEl = document.getElementById('auctionCountdown');
  if (countdownEl) {
    var endTime = new Date(countdownEl.getAttribute('data-end')).getTime();
    function updateCountdown() {
      var now = Date.now();
      var diff = endTime - now;
      if (diff <= 0) {
        countdownEl.textContent = 'Auction ended';
        countdownEl.classList.add('ending-soon');
        return;
      }
      var days = Math.floor(diff / 86400000);
      var hours = Math.floor((diff % 86400000) / 3600000);
      var mins = Math.floor((diff % 3600000) / 60000);
      var secs = Math.floor((diff % 60000) / 1000);

      var parts = [];
      if (days > 0) parts.push(days + 'd');
      parts.push(hours + 'h');
      parts.push(mins + 'm');
      parts.push(secs + 's');
      countdownEl.textContent = parts.join(' ');

      if (diff < 3600000) countdownEl.classList.add('ending-soon');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }
})();
</script>

