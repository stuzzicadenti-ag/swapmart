<%- include('../partials/header', { pageTitle: 'Create Listing', user }) %>

<section class="py-3">
  <div class="container" style="max-width: 700px;">
    <h1 class="section-heading mb-1">Create a Listing</h1>
    <p class="section-subheading mb-2">List your item for sale, swap, auction, or all of the above.</p>

    <% if (typeof kycVerified !== 'undefined' && !kycVerified) { %>
      <div class="kyc-banner">
        <span class="kyc-banner__icon">&#9888;</span>
        <div>
          <strong>Identity not verified.</strong> Listings above CHF 500 and auctions require KYC verification.
          <a href="/profile/verify">Verify now</a>
        </div>
      </div>
    <% } %>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card">
      <div class="card-body" style="padding: 1.5rem;">
        <form action="/listings/new" method="POST" enctype="multipart/form-data" id="listingForm">
          <div class="form-group">
            <label for="title">Title *</label>
            <input type="text" id="title" name="title" class="form-control" required
                   placeholder="e.g. iPhone 15 Pro Max 256GB" maxlength="255">
          </div>

          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control" rows="5"
                      placeholder="Describe your item in detail: condition, features, reason for selling..."></textarea>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label for="category_id">Category *</label>
              <select id="category_id" name="category_id" class="form-control" required>
                <option value="">Select a category</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="condition">Condition *</label>
              <select id="condition" name="condition" class="form-control" required>
                <option value="">Select condition</option>
                <option value="new">New</option>
                <option value="like_new">Like New</option>
                <option value="good">Good</option>
                <option value="fair">Fair</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label for="type">Listing Type *</label>
              <select id="type" name="type" class="form-control" required onchange="togglePrice()">
                <option value="sell">For Sale</option>
                <option value="swap">For Swap</option>
                <option value="both">Sell or Swap</option>
              </select>
            </div>

            <div class="form-group">
              <label for="listing_mode">Listing Mode *</label>
              <select id="listing_mode" name="listing_mode" class="form-control" required onchange="toggleMode()">
                <option value="fixed">Fixed Price</option>
                <option value="auction" <%= (typeof kycVerified !== 'undefined' && !kycVerified) ? 'disabled' : '' %>>
                  Auction <%= (typeof kycVerified !== 'undefined' && !kycVerified) ? '(KYC required)' : '' %>
                </option>
              </select>
            </div>
          </div>

          <!-- Fixed Price fields -->
          <div id="fixedPriceFields">
            <div class="form-group" id="priceGroup">
              <label for="price">Price (CHF)</label>
              <input type="number" id="price" name="price" class="form-control"
                     step="0.01" min="0" placeholder="0.00">
            </div>
          </div>

          <!-- Auction fields (hidden by default) -->
          <div id="auctionFields" style="display: none;">
            <div style="background: var(--amber-50); border: 1px solid var(--amber-200); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem;">
              <h3 style="font-size: 0.9rem; font-weight: 600; color: var(--amber-700); margin-bottom: 0.75rem;">Auction Settings</h3>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group" style="margin-bottom: 0.5rem;">
                  <label for="starting_price">Starting Price (CHF) *</label>
                  <input type="number" id="starting_price" name="starting_price" class="form-control"
                         step="0.01" min="0" placeholder="1.00">
                </div>

                <div class="form-group" style="margin-bottom: 0.5rem;">
                  <label for="buy_now_price">Buy Now Price (CHF)</label>
                  <input type="number" id="buy_now_price" name="buy_now_price" class="form-control"
                         step="0.01" min="0" placeholder="Optional">
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label for="auction_duration">Duration</label>
                  <select id="auction_duration" name="auction_duration" class="form-control">
                    <option value="3">3 days</option>
                    <option value="5">5 days</option>
                    <option value="7" selected>7 days</option>
                    <option value="10">10 days</option>
                  </select>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label for="min_bid_increment">Min Bid Increment (CHF)</label>
                  <input type="number" id="min_bid_increment" name="min_bid_increment" class="form-control"
                         step="0.01" min="0.01" value="1.00" placeholder="1.00">
                </div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" class="form-control"
                   placeholder="e.g. Zurich, CH">
          </div>

          <div class="form-group">
            <label>Images * (1-5 photos, max 10MB each)</label>
            <label class="file-upload" id="imageUploadLabel">
              <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/webp" multiple required>
              <span class="file-upload__icon">&#128247;</span>
              <span class="file-upload__text">
                <strong>Click to upload photos</strong><br>
                JPG, PNG, or WebP. First image will be the cover.
              </span>
            </label>
            <p class="text-sm" style="color: var(--danger); display: none;" id="imageError"></p>
            <div id="imagePreview" style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;"></div>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="padding: 0.875rem; font-size: 1rem; margin-top: 0.5rem;">
            Create Listing
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function togglePrice() {
    var type = document.getElementById('type').value;
    var priceGroup = document.getElementById('priceGroup');
    if (type === 'swap') {
      priceGroup.style.opacity = '0.5';
      document.getElementById('price').value = '';
    } else {
      priceGroup.style.opacity = '1';
    }
  }

  function toggleMode() {
    var mode = document.getElementById('listing_mode').value;
    document.getElementById('fixedPriceFields').style.display = mode === 'fixed' ? 'block' : 'none';
    document.getElementById('auctionFields').style.display = mode === 'auction' ? 'block' : 'none';
  }

  // Client-side image validation + preview
  var imageInput = document.getElementById('images');
  var imageError = document.getElementById('imageError');
  var imagePreview = document.getElementById('imagePreview');

  imageInput.addEventListener('change', function() {
    var files = this.files;
    imageError.style.display = 'none';
    imagePreview.innerHTML = '';

    if (files.length === 0) {
      imageError.textContent = 'At least 1 photo is required.';
      imageError.style.display = 'block';
    } else if (files.length > 5) {
      imageError.textContent = 'Maximum 5 photos allowed. You selected ' + files.length + '.';
      imageError.style.display = 'block';
      this.value = '';
    } else {
      var allowed = ['image/jpeg', 'image/png', 'image/webp'];
      for (var i = 0; i < files.length; i++) {
        if (allowed.indexOf(files[i].type) === -1) {
          imageError.textContent = 'Invalid file type: ' + files[i].name + '. Only JPG, PNG, WebP allowed.';
          imageError.style.display = 'block';
          this.value = '';
          return;
        }
        if (files[i].size > 10 * 1024 * 1024) {
          imageError.textContent = files[i].name + ' exceeds 10MB limit.';
          imageError.style.display = 'block';
          this.value = '';
          return;
        }
      }
      // Show preview thumbnails
      for (var j = 0; j < files.length; j++) {
        var reader = new FileReader();
        reader.onload = function(e) {
          var img = document.createElement('img');
          img.src = e.target.result;
          img.style.cssText = 'width:64px;height:48px;object-fit:cover;border-radius:6px;border:2px solid var(--border);';
          imagePreview.appendChild(img);
        };
        reader.readAsDataURL(files[j]);
      }
    }
  });

  document.getElementById('listingForm').addEventListener('submit', function(e) {
    if (imageInput.files.length === 0) {
      e.preventDefault();
      imageError.textContent = 'At least 1 photo is required.';
      imageError.style.display = 'block';
      imageInput.focus();
    } else if (imageInput.files.length > 5) {
      e.preventDefault();
      imageError.textContent = 'Maximum 5 photos allowed.';
      imageError.style.display = 'block';
    }
  });
</script>

<%- include('../partials/footer') %>
