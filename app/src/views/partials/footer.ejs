            <a href="/health" style="color: var(--gray-400); font-size: 0.9375rem;"><%= t('footer.status') %></a>
          </div>
        </div>

        <div>
          <div style="font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gray-200); margin-bottom: 1rem;"><%= t('footer.legal') %></div>
          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <a href="#" style="color: var(--gray-400); font-size: 0.9375rem;"><%= t('footer.terms') %></a>
