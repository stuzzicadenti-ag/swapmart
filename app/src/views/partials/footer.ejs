  </main>
  <!-- Scroll to top -->
  <button type="button" class="scroll-top-btn" id="scrollTopBtn" aria-label="Scroll to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">&#8593;</button>
  <footer class="site-footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__logo">
            &#x1F501; Swap<span>Mart</span>
          </div>
          <p class="footer__desc">
            <%= t('footer.tagline') %>
          </p>
          <span class="footer__swiss">
            &#127464;&#127469; <%= t('footer.made_in_ch') %>
          </span>
        </div>

        <div class="footer__col">
          <div class="footer__col-title"><%= t('footer.marketplace') %></div>
          <a href="/listings"><%= t('footer.browse_listings') %></a>
          <a href="/fees"><%= t('footer.fees_protection') %></a>
          <a href="/faq"><%= t('footer.faq_guidelines') %></a>
          <a href="/auth/register"><%= t('footer.create_account') %></a>
          <a href="/health"><%= t('footer.status') %></a>
        </div>

        <div class="footer__col">
          <div class="footer__col-title"><%= t('footer.legal') %></div>
          <a href="#"><%= t('footer.terms') %></a>
          <a href="#"><%= t('footer.privacy') %></a>
          <a href="#"><%= t('footer.contact') %></a>
        </div>
      </div>

      <div class="footer__bottom">
        <span>&copy; <%= new Date().getFullYear() %> <%= t('footer.copyright') %></span>
        <span><%= t('footer.company') %></span>
      </div>
    </div>
  </footer>
  <script>
    /* Scroll to top button visibility */
    (function() {
      var btn = document.getElementById('scrollTopBtn');
      if (!btn) return;
      var last = 0;
      window.addEventListener('scroll', function() {
        var now = Date.now();
        if (now - last < 100) return;
        last = now;
        btn.classList.toggle('visible', window.scrollY > 400);
      }, { passive: true });
    })();
  </script>
</body>
</html>
