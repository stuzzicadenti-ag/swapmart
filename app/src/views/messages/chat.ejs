<%- include('../partials/header', { pageTitle: 'Messages', user }) %>

<section class="py-3">
  <div class="container" style="max-width: 700px;">
    <a href="/messages" class="text-sm text-light" style="display: inline-block; margin-bottom: 1rem;">&larr; Back to messages</a>

    <!-- Offer context -->
    <div class="card mb-2">
      <div class="card-body">
        <div class="flex-between" style="flex-wrap: wrap; gap: 0.5rem;">
          <div>
            <div class="text-sm text-light">Conversation about</div>
            <div style="font-weight: 600;"><%= offer.listing_title %></div>
          </div>
          <div class="text-sm">
            <span class="text-light">Between</span>
            <strong><%= offer.buyer_name %></strong>
            <span class="text-light">and</span>
            <strong><%= offer.seller_name %></strong>
            &middot;
            <% if (offer.status === 'pending') { %>
              <span class="badge badge-gray">Pending</span>
            <% } else if (offer.status === 'accepted') { %>
              <span class="badge badge-success">Accepted</span>
            <% } else if (offer.status === 'rejected') { %>
              <span class="badge badge-danger">Rejected</span>
            <% } else { %>
              <span class="badge badge-success">Completed</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Info (only after completed transaction) -->
    <% if (typeof contactInfo !== 'undefined' && contactInfo && offer.status === 'completed') { %>
      <div class="card mb-2" style="border-left: 4px solid var(--success);">
        <div class="card-body" style="padding: 1.25rem;">
          <h3 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--primary);">
            &#128101; Contact Information
          </h3>
          <p class="text-sm text-light mb-1" style="font-style: italic;">
            This information is shared because the transaction is complete. Use it to arrange shipping or meetup.
          </p>
          <div style="display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1rem; font-size: 0.9rem; margin-top: 0.75rem;">
            <% if (contactInfo.name) { %>
              <strong>Name:</strong>
              <span><%= contactInfo.name %></span>
            <% } %>
            <% if (contactInfo.email) { %>
              <strong>Email:</strong>
              <span><a href="mailto:<%= contactInfo.email %>"><%= contactInfo.email %></a></span>
            <% } %>
            <% if (contactInfo.phone) { %>
              <strong>Phone:</strong>
              <span><a href="tel:<%= contactInfo.phone %>"><%= contactInfo.phone %></a></span>
            <% } %>
            <% if (contactInfo.address_line1) { %>
              <strong>Address:</strong>
              <span>
                <%= contactInfo.address_line1 %><% if (contactInfo.address_line2) { %>, <%= contactInfo.address_line2 %><% } %><br>
                <% if (contactInfo.postal_code || contactInfo.city) { %>
                  <%= contactInfo.postal_code || '' %> <%= contactInfo.city || '' %><br>
                <% } %>
                <% if (contactInfo.country) { %><%= contactInfo.country %><% } %>
              </span>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- KYC Warning for messaging -->
    <% if (typeof kycRequired !== 'undefined' || (typeof URLSearchParams !== 'undefined')) { %>
      <% var params = new URLSearchParams(typeof __query !== 'undefined' ? __query : ''); %>
    <% } %>

    <!-- Messages -->
    <div class="card card--no-hover" style="min-height: 400px; display: flex; flex-direction: column;">
      <div style="flex: 1; padding: 1rem; overflow-y: auto; max-height: 500px; display: flex; flex-direction: column;" id="messagesContainer">
        <% if (!chatUnlocked) { %>
          <div class="empty-state" style="margin: auto;">
            <div class="empty-state__icon">&#128274;</div>
            <div class="empty-state__title">Chat Locked</div>
            <div class="empty-state__text">Chat unlocks when the offer is accepted. Both parties can message once the seller accepts this offer.</div>
          </div>
        <% } else if (messages.length === 0) { %>
          <div class="empty-state" style="margin: auto;">
            <div class="empty-state__icon">&#128172;</div>
            <div class="empty-state__title">No messages yet</div>
            <div class="empty-state__text">Start the conversation! Send a message below.</div>
          </div>
        <% } else { %>
          <% messages.forEach(msg => { %>
            <div class="chat-message <%= msg.sender_id === user.id ? 'chat-message--sent' : 'chat-message--received' %>">
              <div class="chat-bubble <%= msg.sender_id === user.id ? 'chat-bubble--sent' : 'chat-bubble--received' %>">
                <div class="chat-sender"><%= msg.sender_name %></div>
                <div><%= msg.content %></div>
              </div>
              <div class="chat-time">
                <%= new Date(msg.created_at).toLocaleString('en-CH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                <% if (msg.read_at && msg.sender_id === user.id) { %>
                  <span class="chat-read-indicator" title="Read">&#10003;&#10003;</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Send message form -->
      <div class="chat-input-area">
        <% if (chatUnlocked) { %>
          <form action="/messages/<%= offer.id %>" method="POST" class="chat-input-form">
            <label for="messageContent" class="sr-only">Message</label>
            <input type="text" id="messageContent" name="content" class="form-control" placeholder="Type a message..."
                   required autocomplete="off" aria-label="Type a message" maxlength="5000">
            <button type="submit" class="btn btn-primary" style="border-radius: 999px; padding: 0.625rem 1.25rem;">Send</button>
          </form>
          <script>
            // Show KYC warning if redirected with kyc=required
            if (window.location.search.indexOf('kyc=required') !== -1) {
              var warn = document.createElement('div');
              warn.className = 'alert alert-warning';
              warn.style.marginTop = '8px';
              warn.style.marginBottom = '0';
              warn.innerHTML = '<a href="/profile/verify" style="font-weight:600;color:var(--amber-700)">Complete identity verification</a> to send messages.';
              document.querySelector('.chat-input-area').appendChild(warn);
            }
          </script>
        <% } else { %>
          <div class="chat-input-form" style="opacity: 0.5;">
            <input type="text" class="form-control" placeholder="Chat unlocks when the offer is accepted"
                   disabled>
            <button type="button" class="btn btn-primary" disabled style="border-radius: 999px; padding: 0.625rem 1.25rem;">Send</button>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll to bottom of messages
  const container = document.getElementById('messagesContainer');
  if (container) container.scrollTop = container.scrollHeight;
</script>

<%- include('../partials/footer') %>
